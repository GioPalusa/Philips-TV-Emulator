!/work/philips-software-gles/cache_runtime.c
!/work/philips-software-gles/config.h
!/work/philips-software-gles/framecopy_test.cpp
!/work/philips-software-gles/render_test.c
!/work/philips-software-gles/hwc/
/work/philips-software-gles/hwc/*
!/work/philips-software-gles/hwc/build.py
!/work/philips-gfx/
/work/philips-gfx/*
!/work/philips-gfx/read_ext4.py
!/work/philips-emulator/
/work/philips-emulator/*

+    // Development emulator transport: the broker accepts a separate socket for
+    // each host stream. Keep the existing pipe service handshake and byte ABI.
+    // No application may open /dev/mem or contact a network host directly.
+    struct sockaddr_un address = {};
+    address.sun_family = AF_UNIX;
+    strcpy(address.sun_path, "/dev/socket/philips_hostgpu");
+    fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    if (fd < 0) return -1;
+    if (TEMP_FAILURE_RETRY(connect(fd, (struct sockaddr*)&address,

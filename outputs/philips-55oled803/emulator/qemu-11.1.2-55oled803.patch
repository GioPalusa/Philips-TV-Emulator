+++ b/hw/arm/mt5891_ambilight_measure.inc
@@ -0,0 +1,179 @@
+/*
+ * Optional synthetic raw-measurement fixture for the Philips development board.
+ * Include after QEMU headers. Copy the matching .h/.c alongside this file.
+ * Default: inert. Measurements: PHILIPS_AMBILIGHT_FIXTURE=1.
+ * Or approximate raw OSD input: PHILIPS_AMBILIGHT_FRAMEBUFFER=1.
+ * Framebuffer mode requires philips-osd.inc included before this file.
+ * Independent 50 Hz output VSync: PHILIPS_VIDEO_VSYNC_FIXTURE=1.
+ *
+ * Call philips_amb_measure_init(qdev_get_gpio_in(gic, 95)) once.
+ * After normal backing MMIO read:
+ *   value = philips_amb_measure_filter_read(physical_address, size, value);
+ * On MMIO write, in addition to normal backing behavior:
+ *   philips_amb_measure_observe_write(physical_address, size, value);
+ *
+ * Hook full measurement block f0027b00..0f and accesses overlapping status
+ * f0034224 / acknowledgement f003422e. Filter preserves all unrelated bits.
+ * No ownership of BIM8034. Bit6 is owned only with the VSync fixture enabled.
+ * This wrapper is sole IRQ95 source only
+ * until other output-VSync peripherals exist; then use an OR aggregator.
+ */
+#include "qemu/timer.h"
+#include "hw/core/irq.h"
+#include "mt5891_ambilight_measure.c"
+#include "philips-ambilight-framebuffer.inc"
+
+static MT5891AmbMeasure philips_measure_core;
+static QEMUTimer *philips_measure_timer;
+static qemu_irq philips_measure_irq;
+static bool philips_measure_enabled;
+static bool philips_framebuffer_enabled;
+static bool philips_framebuffer_valid;
+static bool philips_vsync_fixture_enabled;
+static bool philips_measure_irq_level;
+static bool philips_vsync_pending;
+static unsigned philips_vsync_tick_count;
+#define PHILIPS_MEASURE_ROW_NS INT64_C(1000000) /* 20 rows x 50 frames/s */
+
+static void philips_measure_update_combined_irq(void)
+{
+    qemu_set_irq(philips_measure_irq,
+                 philips_measure_irq_level || philips_vsync_pending);
+}
+
+static void philips_measure_irq_changed(void *opaque, bool asserted)
+{
+    (void)opaque;
+    philips_measure_irq_level = asserted;
+    philips_measure_update_combined_irq();
+}
+
+static void philips_measure_tick(void *opaque)
+{
+    (void)opaque;
+    /* A pending row stalls production rather than dropping unread samples. */
+    if (philips_measure_enabled) {
+        if (philips_framebuffer_enabled &&
+            !(philips_measure_core.status & 0x80) &&
+            philips_measure_core.next_row == 0) {
+            bool valid = philips_amb_sample_framebuffer(
+                philips_measure_core.samples);
+            if (!valid) {
+                memset(philips_measure_core.samples, 0,
+                       sizeof(philips_measure_core.samples));
+            }
+            if (valid != philips_framebuffer_valid) {
+                fprintf(stderr, "[Philips Ambilight framebuffer input] %s\n",
+                        valid ? "Sampling supported raw OSD plane2 region."
+                              : "No supported OSD input; measurements are zero.");
+                philips_framebuffer_valid = valid;
+            }
+        }
+        mt5891_amb_measure_step_row(&philips_measure_core);
+    }
+    /* VSync is independent of measurement backpressure. A pending VSync is
+     * level-triggered and coalesces subsequent frames until acknowledged. */
+    if (philips_vsync_fixture_enabled && ++philips_vsync_tick_count == 20) {
+        philips_vsync_tick_count = 0;
+        philips_vsync_pending = true;
+        philips_measure_update_combined_irq();
+    }
+    timer_mod(philips_measure_timer,
+              qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + PHILIPS_MEASURE_ROW_NS);
+}
+
+static void philips_amb_measure_init(qemu_irq irq)
+{
+    const char *opt = getenv("PHILIPS_AMBILIGHT_FIXTURE");
+    philips_measure_enabled = opt && !strcmp(opt, "1");
+    opt = getenv("PHILIPS_AMBILIGHT_FRAMEBUFFER");
+    philips_framebuffer_enabled = opt && !strcmp(opt, "1");
+    philips_measure_enabled |= philips_framebuffer_enabled;
+    opt = getenv("PHILIPS_VIDEO_VSYNC_FIXTURE");
+    philips_vsync_fixture_enabled = opt && !strcmp(opt, "1");
+    if (!philips_measure_enabled && !philips_vsync_fixture_enabled) {
+        return;
+    }
+    philips_measure_irq = irq;
+    mt5891_amb_measure_init(&philips_measure_core,
+                           philips_measure_irq_changed, NULL);
+    if (!philips_framebuffer_enabled) {
+        mt5891_amb_measure_fixture(&philips_measure_core);
+    } else {
+        fprintf(stderr, "[Philips Ambilight framebuffer input] Enabled "
+                "approximate 4x4 sampling per 32x20 cell of raw OSD plane 2; "
+                "no panel composition or calibration. Invalid input is zero.\n");
+    }
+    opt = getenv("PHILIPS_AMBILIGHT_FIXTURE_RGB16");
+    if (philips_framebuffer_enabled && opt) {
+        fprintf(stderr, "Select framebuffer measurements OR constant RGB16 "
+                "fixture, not both.\n");
+        exit(EXIT_FAILURE);
+    }
+    if (philips_measure_enabled && opt) {
+        if (!mt5891_amb_measure_fixture_rgb16(&philips_measure_core, opt)) {
+            fprintf(stderr, "Invalid PHILIPS_AMBILIGHT_FIXTURE_RGB16: "
+                    "expected R,G,B integers in 0..65535 (decimal or 0x hex).\n");
+            exit(EXIT_FAILURE);
+        }
+        fprintf(stderr, "[Philips synthetic Ambilight input] "
+                "Constant RGB16=%s; this is a measurement fixture, "
+                "not captured television video.\n", opt);
+    }
+    mt5891_amb_measure_enable_irq(&philips_measure_core,
+                                  philips_measure_enabled);
+    philips_measure_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                        philips_measure_tick, NULL);
+    timer_mod(philips_measure_timer,
+              qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + PHILIPS_MEASURE_ROW_NS);
+}
+
+static uint64_t philips_amb_measure_filter_read(hwaddr address, unsigned size,
+                                               uint64_t value)
+{
+    if (!philips_measure_enabled && !philips_vsync_fixture_enabled) {
+        return value;
+    }
+    if (philips_measure_enabled &&
+        address >= MT5891_AMB_MEASURE_BASE &&
+        address < MT5891_AMB_MEASURE_BASE + MT5891_AMB_MEASURE_SIZE &&
+        size <= MT5891_AMB_MEASURE_BASE + MT5891_AMB_MEASURE_SIZE - address) {
+        return mt5891_amb_measure_read(&philips_measure_core,
+                                       address - MT5891_AMB_MEASURE_BASE, size);
+    }
+    if (size <= 8 && address <= UINT64_C(0xf0034224) &&
+        UINT64_C(0xf0034224) - address < size) {
+        unsigned shift = (UINT64_C(0xf0034224) - address) * 8;
+        uint8_t mask = (philips_measure_enabled ? 0x80 : 0) |
+                       (philips_vsync_fixture_enabled ? 0x40 : 0);
+        uint8_t status = (philips_measure_core.status & 0x80) |
+                         (philips_vsync_pending ? 0x40 : 0);
+        value &= ~((uint64_t)mask << shift);
+        value |= (uint64_t)(status & mask) << shift;
+    }
+    return value;
+}
+
+static void philips_amb_measure_observe_write(hwaddr address, unsigned size,
+                                             uint64_t value)
+{
+    if (!philips_measure_enabled && !philips_vsync_fixture_enabled) {
+        return;
+    }
+    if (philips_measure_enabled &&
+        address >= MT5891_AMB_MEASURE_BASE &&
+        address < MT5891_AMB_MEASURE_BASE + MT5891_AMB_MEASURE_SIZE &&
+        size <= MT5891_AMB_MEASURE_BASE + MT5891_AMB_MEASURE_SIZE - address) {
+        mt5891_amb_measure_write(&philips_measure_core,
+                                address - MT5891_AMB_MEASURE_BASE, value, size);
+    }
+    if (size <= 8 && address <= UINT64_C(0xf003422e) &&
+        UINT64_C(0xf003422e) - address < size) {
+        unsigned shift = (UINT64_C(0xf003422e) - address) * 8;
+        mt5891_amb_measure_ack(&philips_measure_core, (value >> shift) & 0x80);
+        if (philips_vsync_fixture_enabled && ((value >> shift) & 0x40)) {
+            philips_vsync_pending = false;
+            philips_measure_update_combined_irq();
+        }
+    }
+}

@@ -0,0 +1,249 @@
+/*
+ * Philips TPM171E stock DT timer contract, with legacy timer1/2 counters.
+ * Timer0 is an UP counter plus absolute comparator in the exact stock DT
+ * driver (clocksource_mmio_readl_up, mt53xx_time_set_next_event).
+ * Older vendor timer.c is only authoritative for the timer1/2 register layout.
+ */
+#include "qemu/timer.h"
+#include "hw/core/irq.h"
+#include "system/reset.h"
+
+#define PTV_TIMER_HZ 24000000U
+typedef struct PhilipsTimerChannel {
+    uint64_t count, limit, stamp;
+    uint32_t period;
+    QEMUTimer *event;
+    qemu_irq irq;
+    unsigned index;
+    bool expired;
+} PhilipsTimerChannel;
+
+static struct {
+    PhilipsTimerChannel channel[3];
+    uint32_t control, status, mask;
+} philips_timer;
+
+static uint64_t philips_timer_ticks(void)
+{
+    return muldiv64(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL),
+                    PTV_TIMER_HZ, NANOSECONDS_PER_SECOND);
+}
+
+static void philips_timer_irq(void)
+{
+    for (unsigned i = 0; i < 3; i++) {
+        qemu_set_irq(philips_timer.channel[i].irq,
+                     !!(philips_timer.status & philips_timer.mask &
+                        (1U << (3 + i))));
+    }
+}
+
+static uint64_t philips_timer_count(PhilipsTimerChannel *c, uint64_t now)
+{
+    if (c->index == 0) {
+        /* Clocksource must keep advancing even with its comparator disabled. */
+        return c->count + now - c->stamp;
+    }
+    if (!(philips_timer.control & (1U << (8 * c->index))) || c->expired) {
+        return c->count;
+    }
+    uint64_t elapsed = now - c->stamp;
+    if (elapsed <= c->count) {
+        return c->count - elapsed;
+    }
+    if (!(philips_timer.control & (2U << (8 * c->index)))) {
+        return 0;
+    }
+    /* A zero programmed limit has a one-tick period. */
+    uint64_t period = c->limit ? c->limit : 1;
+    return period - 1 - ((elapsed - c->count - 1) % period);
+}
+
+static void philips_timer_schedule(PhilipsTimerChannel *c)
+{
+    uint64_t now = philips_timer_ticks(), ticks;
+    int64_t ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    timer_del(c->event);
+    if (!(philips_timer.control & (1U << (8 * c->index))) || c->expired) {
+        return;
+    }
+    if (c->index == 0) {
+        ticks = (uint32_t)((uint32_t)c->limit -
+                           (uint32_t)philips_timer_count(c, now));
+        if (!ticks) {
+            ticks = 1;
+        }
+    } else {
+        ticks = philips_timer_count(c, now);
+        if (!ticks) {
+            ticks = 1;
+        }
+    }
+    /* A 64-bit vendor timestamp may expire many thousands of years away. */
+    uint64_t max_ticks = muldiv64(INT64_MAX - ns,
+                                  PTV_TIMER_HZ, NANOSECONDS_PER_SECOND);
+    if (ticks >= max_ticks) {
+        return;
+    }
+    uint64_t delta = muldiv64(ticks, NANOSECONDS_PER_SECOND, PTV_TIMER_HZ);
+    if (muldiv64(delta, PTV_TIMER_HZ, NANOSECONDS_PER_SECOND) < ticks) {
+        delta++;
+    }
+    timer_mod(c->event, ns + delta);
+}
+
+static void philips_timer_expire(void *opaque)
+{
+    PhilipsTimerChannel *c = opaque;
+    uint64_t now = philips_timer_ticks();
+    philips_timer.status |= 1U << (3 + c->index);
+    if (philips_timer.control & (2U << (8 * c->index))) {
+        if (c->index == 0) {
+            /*
+             * The DT driver uses one-shot mode. Periodic stepping is a
+             * compatibility approximation pending a physical timer trace.
+             */
+            c->limit = (uint32_t)c->limit + (c->period ? c->period : 1);
+        } else {
+            c->count = c->limit;
+            c->stamp = now;
+        }
+    } else {
+        c->expired = true;
+        if (c->index != 0) {
+            c->count = 0;
+            c->stamp = now;
+        }
+    }
+    philips_timer_irq();
+    philips_timer_schedule(c);
+}
+
+static int philips_timer_register(hwaddr offset, bool *high, bool *limit)
+{
+    if (offset >= 0x8060 && offset <= 0x8074 && !(offset & 3)) {
+        *high = false;
+        *limit = !(offset & 4);
+        return (offset - 0x8060) / 8;
+    }
+    if (offset >= 0x8180 && offset <= 0x8194 && !(offset & 3)) {
+        *high = true;
+        *limit = !(offset & 4);
+        return (offset - 0x8180) / 8;
+    }
+    return -1;
+}
+
+static bool philips_timer_read(hwaddr offset, unsigned size, uint64_t *value)
+{
+    bool high, limit;
+    int i;
+    if (size != 4) {
+        return false;
+    }
+    if (offset == 0x8078) {
+        *value = philips_timer.control;
+    } else if (offset == 0x8030) {
+        *value = philips_timer.status;
+    } else if (offset == 0x8034) {
+        *value = philips_timer.mask;
+    } else if (offset == 0x8038) {
+        *value = 0;
+    } else if ((i = philips_timer_register(offset, &high, &limit)) >= 0) {
+        PhilipsTimerChannel *c = &philips_timer.channel[i];
+        uint64_t v = limit ? c->limit : philips_timer_count(c, philips_timer_ticks());
+        *value = (uint32_t)(high ? v >> 32 : v);
+    } else {
+        return false;
+    }
+    return true;
+}
+
+static bool philips_timer_write(hwaddr offset, unsigned size, uint32_t value)
+{
+    bool high, limit;
+    int i;
+    uint64_t now = philips_timer_ticks();
+    if (size != 4) {
+        return false;
+    }
+    if (offset == 0x8034) {
+        philips_timer.mask = value;
+        philips_timer_irq();
+        return true;
+    }
+    if (offset == 0x8038) {
+        philips_timer.status &= ~value;
+        philips_timer_irq();
+        return true;
+    }
+    if (offset == 0x8078) {
+        for (i = 0; i < 3; i++) {
+            PhilipsTimerChannel *c = &philips_timer.channel[i];
+            c->count = philips_timer_count(c, now);
+            c->stamp = now;
+            if (!(philips_timer.control & (1U << (8 * i))) &&
+                (value & (1U << (8 * i)))) {
+                c->expired = false;
+            }
+        }
+        philips_timer.control = value;
+    } else if ((i = philips_timer_register(offset, &high, &limit)) >= 0) {
+        PhilipsTimerChannel *c = &philips_timer.channel[i];
+        uint64_t old = limit ? c->limit : philips_timer_count(c, now);
+        uint64_t v = high ? ((uint64_t)value << 32) | (uint32_t)old :
+                           (old & UINT64_C(0xffffffff00000000)) | value;
+        if (limit) {
+            c->limit = v;
+            if (!high && i == 0) {
+                c->period = value - (uint32_t)philips_timer_count(c, now);
+            }
+        } else {
+            c->count = v;
+            c->stamp = now;
+        }
+        c->expired = false;
+    } else {
+        return false;
+    }
+    for (i = 0; i < 3; i++) {
+        philips_timer_schedule(&philips_timer.channel[i]);
+    }
+    return true;
+}
+
+static void philips_timer_reset(void *opaque)
+{
+    uint64_t now = philips_timer_ticks();
+    /*
+     * Preloader handoff assumption from vendor timer.c: timestamp timer2
+     * already counts down from all ones. IRQ mask is left enabled because
+     * the DT kernel masks individual interrupts at the GIC.
+     */
+    philips_timer.control = 3U << 16;
+    philips_timer.status = 0;
+    philips_timer.mask = UINT32_MAX;
+    for (unsigned i = 0; i < 3; i++) {
+        PhilipsTimerChannel *c = &philips_timer.channel[i];
+        c->count = c->limit = i == 2 ? UINT64_MAX : 0;
+        c->stamp = now;
+        c->expired = false;
+        c->period = 0;
+        timer_del(c->event);
+    }
+    philips_timer_irq();
+}
+
+/* Timer0 SPI75 is confirmed by live DT and stock kernel IRQ107. */
+static void philips_timer_init(qemu_irq irq0, qemu_irq irq1, qemu_irq irq2)
+{
+    qemu_irq irqs[] = {irq0, irq1, irq2};
+    for (unsigned i = 0; i < 3; i++) {
+        PhilipsTimerChannel *c = &philips_timer.channel[i];
+        c->index = i;
+        c->irq = irqs[i];
+        c->event = timer_new_ns(QEMU_CLOCK_VIRTUAL, philips_timer_expire, c);
+    }
+    philips_timer_reset(NULL);
+    qemu_register_reset(philips_timer_reset, NULL);
+}

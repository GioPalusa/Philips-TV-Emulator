+static void philips_modify_dtb(const struct arm_boot_info *info, void *fdt)
+{
+    /* arm_load_dtb normally replaces memory nodes with -m's single bank.
+     * Restore the measured discontiguous TV DRAM banks after that step.
+     */
+    qemu_fdt_setprop_cells(fdt, "/memory@0", "reg",
+        0x00000000, 0x371e0000, 0x40000000, 0x2b804000,
+        0x8c748000, 0x138b8000);
+}

+/*
+ * MT5891 polled servo ADC, derived from stock dtv_driver.ko.
+ * Board inputs are held at full scale: channel1=1023 is outside every
+ * physical-key range in the supplied TV's DRVCUST table (largest max=955).
+ * No key events or interrupts are synthesized. Conversion latency is idealized
+ * as immediate; the host waits 50us before checking the completed channel.
+ */
+#include "system/reset.h"
+
+#define PTV_ADC_BASE 0x28300
+#define PTV_ADC_END  0x283c0
+#define PTV_ADC_CHANNELS 11
+
+static struct {
+    uint32_t config[0x90 / 4];
+    uint32_t status;
+    uint16_t sample[PTV_ADC_CHANNELS];
+} philips_servoadc;
+
+static bool philips_servoadc_access(hwaddr offset, unsigned size)
+{
+    return offset >= PTV_ADC_BASE && offset < PTV_ADC_END &&
+           (size == 1 || size == 2 || size == 4) &&
+           (offset & 3) + size <= 4;
+}
+
+static bool philips_servoadc_read(hwaddr offset, unsigned size, uint64_t *value)
+{
+    uint32_t reg;
+    unsigned index, shift = 8 * (offset & 3);
+    if (!philips_servoadc_access(offset, size)) {
+        return false;
+    }
+    index = (offset - PTV_ADC_BASE) / 4;
+    if (index < 0x90 / 4) {
+        reg = philips_servoadc.config[index];
+    } else if (index == 0x90 / 4) {
+        reg = philips_servoadc.status;
+    } else {
+        unsigned channel = index - 0x94 / 4;
+        reg = (uint32_t)philips_servoadc.sample[channel] << 2;
+    }
+    *value = (reg >> shift) & ((UINT64_C(1) << (8 * size)) - 1);
+    return true;
+}
+
+static bool philips_servoadc_write(hwaddr offset, unsigned size, uint64_t value)
+{
+    uint32_t mask, old, selected;
+    unsigned index, shift = 8 * (offset & 3);
+    if (!philips_servoadc_access(offset, size)) {
+        return false;
+    }
+    index = (offset - PTV_ADC_BASE) / 4;
+    if (index >= 0x90 / 4) {
+        return true; /* Converter owns completion status and sample values. */
+    }
+    mask = ((UINT64_C(1) << (8 * size)) - 1) << shift;
+    old = philips_servoadc.config[index];
+    philips_servoadc.config[index] =
+        (old & ~mask) | (((uint32_t)value << shift) & mask);
+
+    /*
+     * PDWNC_ReadServoADCChannelValue ORs a requested bit into ADC_CONFIG1
+     * and polls last-channel only for a newly enabled channel. Already enabled
+     * channels are treated as continuous conversion by the stock driver.
+     */
+    if (index == 1) {
+        selected = philips_servoadc.config[1] & ~old & 0x7ff;
+    } else if (index == 0 && !(old & 1) &&
+               (philips_servoadc.config[0] & 1)) {
+        selected = philips_servoadc.config[1] & 0x7ff;
+    } else {
+        selected = 0;
+    }
+    if (philips_servoadc.config[0] & 1) {
+        for (unsigned channel = 0; channel < PTV_ADC_CHANNELS; channel++) {
+            if (selected & (1U << channel)) {
+                /* Input is a stable board pull-up, never a pressed button. */
+                philips_servoadc.sample[channel] = 1023;
+                philips_servoadc.status = channel;
+            }
+        }
+    }
+    return true;
+}
+
+static void philips_servoadc_reset(void *opaque)
+{
+    (void)opaque;
+    memset(&philips_servoadc, 0, sizeof(philips_servoadc));
+    /* Initialize latches to the same neutral voltage used by conversions. */
+    for (unsigned i = 0; i < PTV_ADC_CHANNELS; i++) {
+        philips_servoadc.sample[i] = 1023;
+    }
+}
+
+static void philips_servoadc_init(void)
+{
+    philips_servoadc_reset(NULL);
+    qemu_register_reset(philips_servoadc_reset, NULL);
+}

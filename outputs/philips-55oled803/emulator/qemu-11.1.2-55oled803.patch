+static MT5891AmbSpi philips_ambilight;
+static FILE *philips_ambilight_log;
+
+static void philips_ambilight_capture(void *opaque, uint64_t sequence,
+                                     const uint8_t *bytes, size_t count,
+                                     unsigned m, unsigned n, bool complete)
+{
+    if (!philips_ambilight_log) {
+        return;
+    }
+    fprintf(philips_ambilight_log,
+        "{\"schema\":\"mt5891-ambilight-spi-v1\",\"sequence\":%" PRIu64
+        ",\"complete\":%s,\"m\":%u,\"n\":%u,\"data_hex\":\"",
+        sequence, complete ? "true" : "false", m, n);
+    for (size_t i = 0; i < count; i++) {
+        fprintf(philips_ambilight_log, "%02x", bytes[i]);
+    }
+    fputs("\"}\n", philips_ambilight_log);
+    fflush(philips_ambilight_log);
+}
+
+static uint64_t philips_mmio_read(void *opaque, hwaddr offset, unsigned size)
+{
+    uint64_t value;
+    if (philips_smp_read(offset, size, &value)) {
+        return value;
+    }
+    if (philips_timer_read(offset, size, &value)) {
+        if ((offset & ~3ULL) == 0x8030) {
+            value |= (philips_gfx_bim_status() >> (8 * (offset & 3))) &
+                     (UINT32_MAX >> (8 * (4 - size)));
+        }
+        return value;
+    }
+    if (philips_pdwnc_read(offset, size, &value)) {
+        return value;
+    }
+    if (philips_gfx_read(offset, size, &value)) {
+        return value;
+    }
+    if (philips_aproc_read(offset, size, &value)) {
+        return value;
+    }
+    if (philips_servoadc_read(offset, size, &value)) {
+        return value;
+    }
+    if (philips_osd_read(offset, size, &value)) {
+        return value;
+    }
+    if ((philips_measure_enabled || philips_vsync_fixture_enabled) &&
+        ((offset >= 0x27b00 && offset < 0x27b10) ||
+         (offset >= 0x34224 && offset < 0x34228))) {
+        return philips_amb_measure_filter_read(0xf0000000 + offset, size, 0);
+    }
+    if (offset >= 0x29400 && offset < 0x29450) {
+        return mt5891_amb_spi_read(&philips_ambilight, offset - 0x29400, size);
+    }
+    /* PDWNC UARTs 2/4/5, as defined by mt53xx_uart.h. Transmit is
+     * synchronous; RX is empty. Modem peers and RX IRQs are not modeled.
+     */
+    if (offset >= 0x28800 && offset < 0x288c0) {
+        unsigned r = offset - 0x28800;
+        if (r == 0x34 || r == 0x74 || r == 0xb4) {
+            return 0x1f00;
+        }
+        if (r == 4 || r == 0x48 || r == 0x84) {
+            return (philips_pd_uart_regs[r / 4] & 0x40) | 2;
+        }
+        if (r == 0x10 || r == 0x50 || r == 0x90) {
+            return 0;
+        }
+        return philips_pd_uart_regs[r / 4];
+    }
+    philips_note_mmio(offset, size, false);
+    return 0;
+}
+
+static void philips_mmio_write(void *opaque, hwaddr offset, uint64_t value,
+                              unsigned size)
+{
+    philips_amb_measure_observe_write(0xf0000000 + offset, size, value);
+    bool smp_handled = philips_smp_write(offset, size, value);
+    bool timer_handled = philips_timer_write(offset, size, value);
+    if ((offset & ~3ULL) == 0x8034) {
+        philips_gfx_bim_enable(philips_timer.mask);
+    }
+    if ((offset & ~3ULL) == 0x8038) {
+        philips_gfx_bim_clear(value << (8 * (offset & 3)));
+    }
+    if (smp_handled || timer_handled) {
+        return;
+    }
+    if (philips_pdwnc_write(offset, size, value)) {
+        return;
+    }
+    if (philips_gfx_write(offset, size, value)) {
+        return;
+    }
+    if (philips_aproc_write(offset, size, value)) {
+        return;
+    }
+    if (philips_servoadc_write(offset, size, value)) {
+        return;
+    }
+    if (philips_osd_write(offset, size, value)) {
+        return;
+    }
+    if ((philips_measure_enabled || philips_vsync_fixture_enabled) &&
+        ((offset >= 0x27b00 && offset < 0x27b10) ||
+         (offset >= 0x3422c && offset < 0x34230))) {
+        return;
+    }
+    if (offset >= 0x29400 && offset < 0x29450) {
+        mt5891_amb_spi_write(&philips_ambilight, offset - 0x29400, value, size);
+        return;
+    }
+    if (offset >= 0x28800 && offset < 0x288c0) {
+        unsigned r = offset - 0x28800;
+        if (r == 0 || r == 0x44 || r == 0x80) {
+            return; /* Peripheral UARTs: no attached peer. */
+        }
+        philips_pd_uart_regs[r / 4] = value;
+        if (r == 0x38 || r == 0x78 || r == 0xb8) {
+            philips_pd_uart_regs[r / 4] &= ~0xc0;
+        }
+        return;
+    }
+    philips_note_mmio(offset, size, true);
+}
+
+static const MemoryRegionOps philips_mmio_ops = {
+    .read = philips_mmio_read,
+    .write = philips_mmio_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+};

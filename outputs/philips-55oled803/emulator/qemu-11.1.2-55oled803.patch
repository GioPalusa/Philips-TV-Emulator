+/*
+ * Include after philips-osd.inc and mt5891_ambilight_measure.c.
+ * Uses the existing OSD register state and RAM-only DMA reader.
+ */
+#include "mt5891_ambilight_framebuffer.c"
+
+static bool philips_amb_framebuffer_read(void *opaque, uint32_t address,
+                                        void *destination, size_t count)
+{
+    (void)opaque;
+    return philips_osd_dma_read(address, destination, count);
+}
+
+static bool philips_amb_sample_framebuffer(
+    uint16_t output[3][MT5891_AMB_ROWS][MT5891_AMB_COLUMNS])
+{
+    if (!philips_osd.enabled) {
+        return false;
+    }
+    uint32_t control = ldl_le_p(philips_osd.regs + 0x300);
+    uint32_t header = (ldl_le_p(philips_osd.regs + 0x304) & 0x0fffffff) << 4;
+    return mt5891_amb_framebuffer_sample(control, header,
+                                          philips_amb_framebuffer_read,
+                                          NULL, output);
+}

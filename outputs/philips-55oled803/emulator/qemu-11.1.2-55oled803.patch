@@ -0,0 +1,139 @@
+/*
+ * MT5891 PDWNC/T8032 mailbox, derived from the exact 2021 dtv_driver.ko.
+ * This is a high-level mailbox peer, not an 8051 CPU emulator. Only decoded
+ * commands are acknowledged; unknown commands stay pending and are logged.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "hw/core/irq.h"
+#include "system/reset.h"
+
+static struct {
+    qemu_irq irq;
+    uint32_t status, enable, response, command, data, trigger;
+    uint8_t mode;
+    bool notifications;
+    uint64_t requests, unsupported;
+} philips_pdwnc;
+
+static void philips_pdwnc_update_irq(void)
+{
+    qemu_set_irq(philips_pdwnc.irq,
+                 !!(philips_pdwnc.status & philips_pdwnc.enable));
+}
+
+static void philips_pdwnc_request(void)
+{
+    unsigned command = philips_pdwnc.command & 0xff;
+    unsigned subcommand = (philips_pdwnc.command >> 8) & 0xff;
+    bool supported = false;
+    philips_pdwnc.requests++;
+    /*
+     * PDWNC_Init sends 0x0186 and checks an exact response 0x86.
+     * _PDWNC_SetT8032(4/5) sends 0x0186 / 0x0286. Both call sites
+     * inspect only the command echo/status, and change shared-control bit16.
+     */
+    if (command == 0x86 && (subcommand == 1 || subcommand == 2)) {
+        philips_pdwnc.notifications = subcommand == 1;
+        supported = true;
+    }
+    /*
+     * _PDWNC_InitT8032 sends command2/sub1; _PDWNC_SetT8032(0) sends
+     * command2/sub2. These select the normal controller/ARM handshake mode,
+     * with no returned payload consumed by the host. Retain that mode so
+     * the command changes state, rather than blindly echoing all requests.
+     */
+    if (command == 2 && (subcommand == 1 || subcommand == 2) &&
+        philips_pdwnc.data == 0) {
+        philips_pdwnc.mode = subcommand;
+        supported = true;
+    }
+    /* Doorbell is consumed by the modeled coprocessor. */
+    philips_pdwnc.trigger &= ~1U;
+    if (supported) {
+        philips_pdwnc.response = command;
+        philips_pdwnc.status |= 1U << 15;
+        fprintf(stderr, "[mt5891-pdwnc] mailbox cmd=%02x sub=%02x data=%08x ack=%08x\n",
+                command, subcommand, philips_pdwnc.data, philips_pdwnc.response);
+    } else {
+        philips_pdwnc.unsupported++;
+        fprintf(stderr, "[mt5891-pdwnc] unsupported mailbox cmd=%02x sub=%02x data=%08x; no ACK\n",
+                command, subcommand, philips_pdwnc.data);
+    }
+    philips_pdwnc_update_irq();
+}
+
+static uint32_t *philips_pdwnc_reg(hwaddr off)
+{
+    switch (off & ~3ULL) {
+    case 0x28040: return &philips_pdwnc.status;
+    case 0x28044: return &philips_pdwnc.enable;
+    case 0x28180: return &philips_pdwnc.response;
+    case 0x28184: return &philips_pdwnc.command;
+    case 0x28188: return &philips_pdwnc.data;
+    case 0x281e8: return &philips_pdwnc.trigger;
+    default: return NULL;
+    }
+}
+
+static bool philips_pdwnc_read(hwaddr off, unsigned size, uint64_t *value)
+{
+    uint32_t *reg;
+    if ((size != 1 && size != 2 && size != 4) || (off & 3) + size > 4) {
+        return false;
+    }
+    if ((off & ~3ULL) == 0x28048) {
+        *value = 0; /* W1C interrupt clear is not a latched configuration. */
+        return true;
+    }
+    reg = philips_pdwnc_reg(off);
+    if (!reg) {
+        return false;
+    }
+    *value = (*reg >> (8 * (off & 3))) & ((1ULL << (8 * size)) - 1);
+    return true;
+}
+
+static bool philips_pdwnc_write(hwaddr off, unsigned size, uint64_t value)
+{
+    uint32_t *reg, mask;
+    unsigned shift = 8 * (off & 3);
+    hwaddr word = off & ~3ULL;
+    if ((size != 1 && size != 2 && size != 4) || (off & 3) + size > 4) {
+        return false;
+    }
+    mask = ((1ULL << (8 * size)) - 1) << shift;
+    value = (value << shift) & mask;
+    if (word == 0x28048) {
+        philips_pdwnc.status &= ~value;
+        philips_pdwnc_update_irq();
+        return true;
+    }
+    reg = philips_pdwnc_reg(off);
+    if (!reg) {
+        return false;
+    }
+    if (word == 0x28040 || word == 0x28180) {
+        return true; /* Peer owns status and response. */
+    }
+    *reg = (*reg & ~mask) | value;
+    if (word == 0x281e8 && (value & 1)) {
+        philips_pdwnc_request();
+    }
+    philips_pdwnc_update_irq();
+    return true;
+}
+
+static void philips_pdwnc_reset(void *opaque)
+{
+    qemu_irq irq = philips_pdwnc.irq;
+    memset(&philips_pdwnc, 0, sizeof(philips_pdwnc));
+    philips_pdwnc.irq = irq;
+    philips_pdwnc_update_irq();
+}
+
+static void philips_pdwnc_init(qemu_irq irq)
+{
+    philips_pdwnc.irq = irq;
+    philips_pdwnc_reset(NULL);
+    qemu_register_reset(philips_pdwnc_reset, NULL);
+}

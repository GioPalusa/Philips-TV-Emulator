+++ b/hw/arm/philips-aproc.inc
@@ -0,0 +1,215 @@
+/*
+ * TPM171E APROC mailbox protocol model, derived from stock dtv_driver.ko.
+ *
+ * This models the host-visible bootstrap/lifecycle handshake only. It does
+ * NOT execute the audio processor firmware, decode sound, update PCM rings,
+ * or implement the processor's shared-memory configuration commands.
+ * See README.md for evidence and the deliberately synthetic timing/token.
+ */
+#include "qemu/timer.h"
+#include "hw/core/irq.h"
+#include "system/reset.h"
+
+#define PTV_APROC_IRQ (1U << 26) /* vendor90 -> Linux IRQ194 -> GIC SPI162 */
+#define PTV_APROC_DELAY_NS 1000000
+
+typedef struct PhilipsAprocRequest {
+    uint32_t word, arg1, arg2;
+} PhilipsAprocRequest;
+
+static struct {
+    uint32_t mailbox[0xa0 / 4];
+    uint32_t control, reset, busy, irq_status, irq_mask;
+    PhilipsAprocRequest request[2];
+    bool ready_pending;
+    unsigned unsupported_count;
+    QEMUTimer *event;
+    qemu_irq irq;
+} philips_aproc;
+
+static void philips_aproc_irq(void)
+{
+    qemu_set_irq(philips_aproc.irq,
+                 !!(philips_aproc.irq_status & philips_aproc.irq_mask &
+                    PTV_APROC_IRQ));
+}
+
+static void philips_aproc_schedule(void)
+{
+    if ((philips_aproc.reset & 1) &&
+        (philips_aproc.ready_pending || philips_aproc.busy)) {
+        timer_mod(philips_aproc.event,
+                  qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + PTV_APROC_DELAY_NS);
+    }
+}
+
+static void philips_aproc_notify(uint32_t word, uint32_t arg1, uint32_t arg2)
+{
+    /* Channel0 is also where NotifyKernelDone reads its ready token. */
+    philips_aproc.mailbox[0] = word;
+    philips_aproc.mailbox[1] = arg1;
+    philips_aproc.mailbox[2] = arg2;
+    philips_aproc.irq_status |= PTV_APROC_IRQ;
+    philips_aproc_irq();
+}
+
+static bool philips_aproc_lifecycle(uint32_t word)
+{
+    unsigned code = (word >> 8) & 0xffff;
+    unsigned type = word & 0xff;
+    bool decoder = (code >= 6 && code <= 9) || code == 0x16;
+
+    /*
+     * Exact callback table at .data+0x5ef88. These completions model virtual
+     * object lifecycle only; a decoder handle does not produce audio.
+     * All these table entries require arg1=1 and wildcard arg2.
+     */
+    return (type == 3 && (code == 1 || code == 5 || decoder)) ||
+           (type == 4 && decoder) || (code == 4 && type == 5);
+}
+
+static void philips_aproc_tick(void *opaque)
+{
+    unsigned channel;
+    PhilipsAprocRequest *r;
+    (void)opaque;
+    if (!(philips_aproc.reset & 1)) {
+        return;
+    }
+    /* Do not overwrite a mailbox before the guest ISR has acknowledged it. */
+    if (philips_aproc.irq_status & PTV_APROC_IRQ) {
+        philips_aproc_schedule();
+        return;
+    }
+    if (philips_aproc.ready_pending) {
+        philips_aproc.ready_pending = false;
+        philips_aproc_notify(0x108, 1, 1);
+        fprintf(stderr, "[mt5891 aproc] synthetic kernel-ready mailbox\n");
+        philips_aproc_schedule();
+        return;
+    }
+    if (!philips_aproc.busy) {
+        return;
+    }
+    channel = (philips_aproc.busy & 1) ? 0 : 1;
+    r = &philips_aproc.request[channel];
+    philips_aproc.busy &= ~(1U << channel);
+    if (philips_aproc_lifecycle(r->word)) {
+        philips_aproc_notify(r->word, 1, 0);
+        fprintf(stderr, "[mt5891 aproc] lifecycle completion cmd=%06x\n",
+                r->word);
+    } else if (philips_aproc.unsupported_count++ < 32) {
+        /*
+         * Hardware consumed the command; do not claim a successful operation
+         * or manufacture a callback for an unknown protocol message.
+         */
+        fprintf(stderr, "[mt5891 aproc unsupported] cmd=%06x p1=%08x p2=%08x\n",
+                r->word, r->arg1, r->arg2);
+    }
+    philips_aproc_schedule();
+}
+
+static bool philips_aproc_read(hwaddr offset, unsigned size, uint64_t *value)
+{
+    if (size != 4 || (offset & 3)) {
+        return false;
+    }
+    if (offset >= 0x8800 && offset < 0x88a0) {
+        *value = philips_aproc.mailbox[(offset - 0x8800) / 4];
+        return true;
+    }
+    switch (offset) {
+    case 0x8080: *value = philips_aproc.irq_status; return true;
+    case 0x8084: *value = philips_aproc.irq_mask; return true;
+    case 0x8088: *value = 0; return true;
+    case 0x8904: *value = philips_aproc.control; return true;
+    case 0x8908: *value = philips_aproc.reset; return true;
+    case 0x8920: *value = philips_aproc.busy; return true;
+    default: return false;
+    }
+}
+
+static bool philips_aproc_write(hwaddr offset, unsigned size, uint64_t value)
+{
+    uint32_t v = value;
+    if (size != 4 || (offset & 3)) {
+        return false;
+    }
+    if (offset >= 0x8800 && offset < 0x88a0) {
+        philips_aproc.mailbox[(offset - 0x8800) / 4] = v;
+        return true;
+    }
+    switch (offset) {
+    case 0x8080:
+        return true; /* IRQ status is device-generated. */
+    case 0x8084:
+        philips_aproc.irq_mask = v;
+        philips_aproc_irq();
+        return true;
+    case 0x8088:
+        philips_aproc.irq_status &= ~(v & PTV_APROC_IRQ);
+        philips_aproc_irq();
+        philips_aproc_schedule();
+        return true;
+    case 0x8904:
+        philips_aproc.control = v;
+        return true;
+    case 0x8908: {
+        uint32_t old = philips_aproc.reset;
+        philips_aproc.reset = v;
+        if (!(v & 1)) {
+            timer_del(philips_aproc.event);
+            philips_aproc.ready_pending = false;
+            philips_aproc.busy = 0;
+            philips_aproc.irq_status = 0;
+            memset(philips_aproc.mailbox, 0, sizeof(philips_aproc.mailbox));
+            philips_aproc_irq();
+        } else if (!(old & 1)) {
+            philips_aproc.ready_pending = true;
+            philips_aproc_schedule();
+        }
+        return true;
+    }
+    case 0x8920:
+        for (unsigned i = 0; i < 2; i++) {
+            unsigned base = (0x80 + i * 0x10) / 4;
+            unsigned bit = 1U << i;
+            if ((v & bit) && !(philips_aproc.busy & bit)) {
+                philips_aproc.request[i] = (PhilipsAprocRequest) {
+                    philips_aproc.mailbox[base],
+                    philips_aproc.mailbox[base + 1],
+                    philips_aproc.mailbox[base + 2],
+                };
+                philips_aproc.busy |= bit;
+            }
+        }
+        philips_aproc_schedule();
+        return true;
+    default:
+        return false;
+    }
+}
+
+static void philips_aproc_reset(void *opaque)
+{
+    (void)opaque;
+    timer_del(philips_aproc.event);
+    memset(philips_aproc.mailbox, 0, sizeof(philips_aproc.mailbox));
+    memset(philips_aproc.request, 0, sizeof(philips_aproc.request));
+    philips_aproc.control = philips_aproc.reset = philips_aproc.busy = 0;
+    philips_aproc.irq_status = 0;
+    /* Match preloader/GIC handoff assumption also used for the BIM timers. */
+    philips_aproc.irq_mask = UINT32_MAX;
+    philips_aproc.ready_pending = false;
+    philips_aproc.unsupported_count = 0;
+    philips_aproc_irq();
+}
+
+static void philips_aproc_init(qemu_irq irq)
+{
+    philips_aproc.irq = irq;
+    philips_aproc.event = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                       philips_aproc_tick, NULL);
+    philips_aproc_reset(NULL);
+    qemu_register_reset(philips_aproc_reset, NULL);
+}

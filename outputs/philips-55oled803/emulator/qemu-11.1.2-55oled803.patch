@@ -0,0 +1,25 @@
+/*
+ * Exact 24 MHz generic-counter conversion for the MT5891 prototype.
+ * A tick is 125/3 ns. Floor reads and ceil deadlines are inverse, so a
+ * fractional-nanosecond tick never causes a timer to expire prematurely.
+ * Decomposition bounds intermediate products without requiring int128.
+ */
+#ifndef ARM_GT24_H
+#define ARM_GT24_H
+
+static inline uint64_t gt24_ns_to_ticks(uint64_t ns)
+{
+    return (ns / 125) * 3 + ((ns % 125) * 3) / 125;
+}
+
+static inline int64_t gt24_ticks_to_ns(uint64_t ticks)
+{
+    uint64_t whole = ticks / 3;
+    uint64_t fraction = ((ticks % 3) * 125 + 2) / 3;
+
+    if (whole > (INT64_MAX - fraction) / 125) {
+        return INT64_MAX;
+    }
+    return whole * 125 + fraction;
+}
+#endif

+++ b/hw/arm/philips-smp.inc
@@ -0,0 +1,151 @@
+/*
+ * Functional model of the secondary CPU power and boot-monitor mailbox
+ * contract used by Philips TPM171E 107.1.143.0, Linux 3.10.79.
+ *
+ * Include from hw/arm/virt.c. Offsets passed below are relative to 0xf0000000.
+ * This replaces the boot monitor's mailbox branch with a QEMU CPU power-on
+ * operation. It does not emulate the original boot ROM instruction by instruction.
+ * Register masks and addresses come from the exact stock kernel disassembly,
+ * not the older GPL tree's differently configured MT5891 definitions.
+ */
+#include "target/arm/arm-powerctl.h"
+#include "target/arm/multiprocessing.h"
+#include "system/reset.h"
+
+typedef struct PhilipsSMPState {
+    uint32_t entry;
+    uint32_t magic;
+    uint32_t power[4];
+    uint32_t progress[4];
+    bool released[4];
+} PhilipsSMPState;
+
+static PhilipsSMPState philips_smp;
+
+enum {
+    PTV_MEM_PD = 1 << 0,
+    PTV_MEM_CKISO = 1 << 2,
+    PTV_MEM_ACK = 1 << 3,
+    PTV_CLK_DIS = 1 << 4,
+    PTV_RESET = 1 << 5,
+    PTV_PWR_ON = 1 << 6,
+    PTV_PWR_ON_2 = 1 << 7,
+    PTV_PWR_ACK = 1 << 8,
+    PTV_PWR_ACK_2 = 1 << 9,
+    PTV_CLAMPS = 3 << 10,
+};
+
+static uint32_t philips_smp_ack(uint32_t value)
+{
+    value &= ~(PTV_MEM_ACK | PTV_PWR_ACK | PTV_PWR_ACK_2);
+    if (value & PTV_MEM_PD) {
+        value |= PTV_MEM_ACK;
+    }
+    if (value & PTV_PWR_ON) {
+        value |= PTV_PWR_ACK;
+    }
+    if (value & PTV_PWR_ON_2) {
+        value |= PTV_PWR_ACK_2;
+    }
+    return value;
+}
+
+static void philips_smp_release(unsigned cpu)
+{
+    uint32_t v = philips_smp.power[cpu];
+    CPUState *cs = qemu_get_cpu(cpu);
+    int result;
+
+    if (!cs || philips_smp.released[cpu] ||
+        philips_smp.magic != 0xffffb007 || !philips_smp.entry ||
+        (philips_smp.entry & 3) ||
+        (v & (PTV_PWR_ON | PTV_PWR_ON_2)) !=
+            (PTV_PWR_ON | PTV_PWR_ON_2) ||
+        (v & (PTV_RESET | PTV_CLK_DIS | PTV_MEM_PD |
+              PTV_MEM_CKISO | PTV_CLAMPS))) {
+        return;
+    }
+    /*
+     * Same exception level as QEMU's primary Linux firmware handoff.
+     * The stock secondary_startup handles both HYP and SVC entry.
+     */
+    result = arm_set_cpu_on(arm_cpu_mp_affinity(ARM_CPU(cs)),
+                           philips_smp.entry, 0,
+                           arm_feature(&ARM_CPU(cs)->env, ARM_FEATURE_EL2) ? 2 : 1,
+                           false);
+    if (result == QEMU_ARM_POWERCTL_RET_SUCCESS) {
+        philips_smp.released[cpu] = true;
+        fprintf(stderr, "[mt5891 smp] released CPU%u at 0x%08x\n",
+                cpu, philips_smp.entry);
+    } else {
+        fprintf(stderr, "[mt5891 smp] CPU%u release failed: %d\n", cpu, result);
+    }
+}
+
+static bool philips_smp_read(hwaddr offset, unsigned size, uint64_t *value)
+{
+    if (size != 4) {
+        return false;
+    }
+    if (offset == 0x8188) {
+        *value = philips_smp.entry;
+    } else if (offset == 0x8068) {
+        *value = philips_smp.magic;
+    } else if (offset >= 0x8408 && offset <= 0x8410 && !(offset & 3)) {
+        *value = philips_smp.power[(offset - 0x8404) / 4];
+    } else if (offset >= 0x88f4 && offset <= 0x88fc && !(offset & 3)) {
+        *value = philips_smp.progress[(offset - 0x88f0) / 4];
+    } else {
+        return false;
+    }
+    return true;
+}
+
+static bool philips_smp_write(hwaddr offset, unsigned size, uint32_t value)
+{
+    unsigned cpu;
+    if (size != 4) {
+        return false;
+    }
+    if (offset == 0x8188) {
+        philips_smp.entry = value;
+    } else if (offset == 0x8068) {
+        philips_smp.magic = value;
+    } else if (offset >= 0x8408 && offset <= 0x8410 && !(offset & 3)) {
+        cpu = (offset - 0x8404) / 4;
+        philips_smp.power[cpu] = philips_smp_ack(value);
+        if ((value & PTV_RESET) && philips_smp.released[cpu]) {
+            CPUState *cs = qemu_get_cpu(cpu);
+            if (cs) {
+                arm_set_cpu_off(arm_cpu_mp_affinity(ARM_CPU(cs)));
+            }
+            philips_smp.released[cpu] = false;
+        }
+    } else if (offset >= 0x88f4 && offset <= 0x88fc && !(offset & 3)) {
+        philips_smp.progress[(offset - 0x88f0) / 4] = value;
+        return true;
+    } else {
+        return false;
+    }
+    for (cpu = 1; cpu < 4; cpu++) {
+        philips_smp_release(cpu);
+    }
+    return true;
+}
+
+static void philips_smp_reset(void *opaque)
+{
+    unsigned cpu;
+    memset(&philips_smp, 0, sizeof(philips_smp));
+    for (cpu = 1; cpu < 4; cpu++) {
+        philips_smp.power[cpu] = philips_smp_ack(
+            PTV_RESET | PTV_CLK_DIS | PTV_MEM_PD |
+            PTV_MEM_CKISO | PTV_CLAMPS);
+    }
+}
+
+static void philips_smp_init(void)
+{
+    philips_smp_reset(NULL);
+    qemu_register_reset(philips_smp_reset, NULL);
+}

+/* MT5891 console: stock UART0 uses a 31-byte FIFO and 115200 8N1.
+ * RX is paced in virtual time; a socket burst must not become an unlimited
+ * stream of immediate receive interrupts into the guest terminal layer.
+ * TX remains an immediate sink for the stock polling boot console.
+ */
+static uint32_t philips_uart_regs[0x1000 / 4];
+static uint32_t philips_pd_uart_regs[0xc0 / 4];
+static CharFrontend philips_console;
+static qemu_irq philips_console_irq;
+static uint8_t philips_uart_rx[31];
+static unsigned philips_uart_rx_count;
+static QEMUTimer *philips_uart_tx_timer;
+static QEMUTimer *philips_uart_rx_timer;
+#define PHILIPS_UART_BYTE_NS 86806 /* ceil(10 bits / 115200 baud), 8N1 */
+static uint8_t philips_uart_ingress[256];
+static unsigned philips_uart_ingress_head, philips_uart_ingress_count;
+
+static void philips_uart_rx_schedule(void)
+{
+    unsigned capacity = (philips_uart_regs[4 / 4] & 0x40) ? 31 : 1;
+    if (philips_uart_ingress_count && philips_uart_rx_count < capacity &&
+        !timer_pending(philips_uart_rx_timer)) {
+        timer_mod(philips_uart_rx_timer,
+                  qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + PHILIPS_UART_BYTE_NS);
+    }
+}
+
+static void philips_uart_irq_update(void)
+{
+    uint32_t pending = philips_uart_regs[0x10 / 4] & (1U << 19);
+    if (philips_uart_rx_count) {
+        pending |= 1U << 18; /* receive timeout, with data available */
+    }
+    philips_uart_regs[0x10 / 4] = pending;
+    qemu_set_irq(philips_console_irq,
+                 !!(pending & philips_uart_regs[0x0c / 4]));
+}
+
+static int philips_uart_can_receive(void *opaque)
+{
+    if (!(philips_uart_regs[0x0c / 4] & ((1U << 17) | (1U << 18)))) {
+        return 0;
+    }
+    return sizeof(philips_uart_ingress) - philips_uart_ingress_count;
+}
+
+static void philips_uart_receive(void *opaque, const uint8_t *buf, int size)
+{
+    /* The character backend honors can_receive; retain bounded backpressure. */
+    size = MIN(size, sizeof(philips_uart_ingress) - philips_uart_ingress_count);
+    for (int i = 0; i < size; i++) {
+        unsigned tail = (philips_uart_ingress_head +
+                         philips_uart_ingress_count) %
+                        sizeof(philips_uart_ingress);
+        philips_uart_ingress[tail] = buf[i];
+        philips_uart_ingress_count++;
+    }
+    philips_uart_rx_schedule();
+}
+
+static void philips_uart_received(void *opaque)
+{
+    unsigned capacity = (philips_uart_regs[4 / 4] & 0x40) ? 31 : 1;
+    if (philips_uart_ingress_count && philips_uart_rx_count < capacity) {
+        philips_uart_rx[philips_uart_rx_count++] =
+            philips_uart_ingress[philips_uart_ingress_head];
+        philips_uart_ingress_head = (philips_uart_ingress_head + 1) %
+                                    sizeof(philips_uart_ingress);
+        philips_uart_ingress_count--;
+    }
+    philips_uart_irq_update();
+    philips_uart_rx_schedule();
+    if (qemu_chr_fe_backend_connected(&philips_console)) {
+        qemu_chr_fe_accept_input(&philips_console);
+    }
+}
+
+static void philips_uart_transmitted(void *opaque)
+{
+    philips_uart_regs[0x10 / 4] |= 1U << 19;
+    philips_uart_irq_update();
+}
+
+static uint64_t philips_uart_read(void *opaque, hwaddr offset, unsigned size)
+{
+    if (offset == 0x4c || offset == 0xcc || offset == 0x18c) {
+        return 0x1f00 | (offset == 0x4c ? philips_uart_rx_count : 0);
+    }
+    if (offset == 4) {
+        return (philips_uart_regs[offset / 4] & 0x40) | 2 |
+               !!philips_uart_rx_count;
+    }
+    if (offset == 0) {
+        uint8_t value = 0;
+        if (philips_uart_rx_count) {
+            value = philips_uart_rx[0];
+            memmove(philips_uart_rx, philips_uart_rx + 1,
+                    --philips_uart_rx_count);
+        }
+        philips_uart_irq_update();
+        /* Resume the serial line after a full FIFO; never refill inline. */
+        philips_uart_rx_schedule();
+        return value;
+    }
+    return (philips_uart_regs[offset / 4] >> ((offset & 3) * 8)) &
+           (UINT32_MAX >> ((4 - size) * 8));
+}
+
+static void philips_uart_write(void *opaque, hwaddr offset, uint64_t value,
+                               unsigned size)
+{
+    if (offset == 0 || offset == 0xc0 || offset == 0xc4) {
+        fputc((unsigned char)value, stderr);
+        fflush(stderr);
+        if (offset == 0 && qemu_chr_fe_backend_connected(&philips_console)) {
+            uint8_t byte = value;
+            qemu_chr_fe_write(&philips_console, &byte, 1);
+        }
+        if (offset == 0) {
+            /* Functional TX sink with deferred empty interrupt. Modeling
+             * per-byte busy time stalls the stock polling console under TCG.
+             */
+            if (!timer_pending(philips_uart_tx_timer)) {
+                timer_mod(philips_uart_tx_timer,
+                          qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 1000000);
+            }
+            philips_uart_regs[0x10 / 4] &= ~(1U << 19);
+            philips_uart_irq_update();
+        }
+        return;
+    }
+    if (offset == 0x10) {
+        /* The driver's interrupt handler writes ~pending: W0C. */
+        philips_uart_regs[0x10 / 4] &= value;
+        philips_uart_irq_update();
+        return;
+    }
+    uint32_t old_enable = philips_uart_regs[0x0c / 4];
+    uint32_t mask = (UINT32_MAX >> ((4 - size) * 8)) << ((offset & 3) * 8);
+    philips_uart_regs[offset / 4] =
+        (philips_uart_regs[offset / 4] & ~mask) |
+        ((value << ((offset & 3) * 8)) & mask);
+    if (offset == 0x0c && (value & ~old_enable & (1U << 19))) {
+        timer_mod(philips_uart_tx_timer,
+                  qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + PHILIPS_UART_BYTE_NS);
+    }
+    if (offset == 0x50 || offset == 0xd0 || offset == 0x190) {
+        if (offset == 0x50 && (value & 0x40)) {
+            philips_uart_rx_count = 0;
+        }
+        if (offset == 0x50 && (value & 0x80)) {
+            timer_del(philips_uart_tx_timer);
+        }
+        philips_uart_regs[offset / 4] &= ~0xc0; /* FIFO flush self-clears. */
+    }
+    philips_uart_irq_update();
+    philips_uart_rx_schedule();
+    if (offset == 0x0c && qemu_chr_fe_backend_connected(&philips_console)) {
+        qemu_chr_fe_accept_input(&philips_console);
+    }
+}
+
+static const MemoryRegionOps philips_uart_ops = {
+    .read = philips_uart_read,
+    .write = philips_uart_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+};
+
+/* Trace accesses to MT5891 peripherals that have no model yet. */
+#include "philips-mmio-trace.h"
+#include "philips-hostgpu.inc"
+static void philips_note_mmio(hwaddr offset, unsigned size, bool write)
+{
+    static PhilipsTraceTable table;
+    hwaddr address = 0xf0000000 + offset;
+    bool first;
+    PhilipsTraceEntry *entry = philips_trace_access(&table, address, &first);
+    if (!entry) {
+        return;
+    }
+    if (first) {
+        fprintf(stderr, "[mt5891 missing %s] 0x%08" HWADDR_PRIx
+                " size=%u pc=0x%08x\n", write ? "write" : "read", address, size,
+                current_cpu ? ARM_CPU(current_cpu)->env.regs[15] : 0);
+    } else if (entry->count >= 1048576 &&
+               !(entry->count & (entry->count - 1))) {
+        fprintf(stderr, "[mt5891 polling %s] 0x%08" HWADDR_PRIx
+                " count=%" PRIu64 " pc=0x%08x\n",
+                write ? "write" : "read", address, entry->count,
+                current_cpu ? ARM_CPU(current_cpu)->env.regs[15] : 0);
+    }
+}

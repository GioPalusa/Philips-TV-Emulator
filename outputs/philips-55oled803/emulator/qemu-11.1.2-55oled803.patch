@@ -0,0 +1,218 @@
+/*
+ * MT5891 OSD plane-2 input view, reverse engineered from this TV's dtv_driver.
+ * This is an uncomposited first-region viewer, not a panel/video compositor.
+ * See README.md for evidence, integration, assumptions and missing hardware.
+ */
+#include "ui/console.h"
+#include "system/address-spaces.h"
+#include "qemu/bswap.h"
+
+static struct {
+    uint8_t regs[0xa00];
+    QemuConsole *con;
+    QEMUTimer *timer;
+    qemu_irq irq;
+    uint32_t mask, pending, current_bitmap;
+    uint32_t previous_header, previous_bitmap;
+    uint8_t previous_region[48];
+    bool enabled, warned, visible;
+} philips_osd;
+
+/* MMIO is deliberately excluded: malformed descriptors must not execute
+ * device reads (including GIC banked reads outside vCPU context).
+ */
+static bool philips_osd_dma_read(uint32_t addr, void *dst, size_t count)
+{
+    MemoryRegionSection section = memory_region_find(get_system_memory(),
+                                                     addr, count);
+    bool valid = section.mr && memory_region_is_ram(section.mr) &&
+                 int128_get64(section.size) >= count;
+    if (valid) {
+        memcpy(dst, (uint8_t *)memory_region_get_ram_ptr(section.mr) +
+               section.offset_within_region, count);
+    }
+    if (section.mr) {
+        memory_region_unref(section.mr);
+    }
+    return valid;
+}
+
+static void philips_osd_irq_update(void)
+{
+    qemu_set_irq(philips_osd.irq,
+                 !!(philips_osd.mask & philips_osd.pending & (1U << 7)));
+}
+
+static bool philips_osd_update(void *opaque)
+{
+    uint8_t header[48];
+    uint32_t control = ldl_le_p(philips_osd.regs + 0x300);
+    uint32_t ptr = (ldl_le_p(philips_osd.regs + 0x304) & 0x0fffffff) << 4;
+    uint32_t bitmap;
+    unsigned width, height, pitch, format, rsel, gsel, bsel;
+    DisplaySurface *surface;
+    uint8_t *row;
+
+    if (!philips_osd.enabled || !(control & 1) || !ptr ||
+        !philips_osd_dma_read(ptr, header, sizeof(header))) {
+        return true;
+    }
+    bitmap = (ldl_le_p(header + 4) & 0x0fffffff) << 4;
+    format = header[3] >> 4;
+    pitch = (lduw_le_p(header + 8) & 0x7ff) << 4;
+    width = lduw_le_p(header + 36) & 0x1fff;
+    height = lduw_le_p(header + 38) & 0xfff;
+    /* 32-bit byte selection is established by _setup_buffer. Other formats
+     * require separate packed-pixel semantics, so don't guess their colors.
+     */
+    if (format != 14 || (header[15] & 0x10) || !width || !height ||
+        width > 4096 || height > 2160 || pitch < width * 4 ||
+        (uint64_t)bitmap + (uint64_t)pitch * height > UINT32_MAX) {
+        if (!philips_osd.warned) {
+            fprintf(stderr, "[mt5891 osd] unsupported/invalid region:"
+                    " header=%08x bitmap=%08x format=%u %ux%u pitch=%u"
+                    " compressed=%u; no pixels substituted\n",
+                    ptr, bitmap, format, width, height, pitch,
+                    !!(header[15] & 0x10));
+            philips_osd.warned = true;
+        }
+        return true;
+    }
+    if (ptr != philips_osd.previous_header ||
+        bitmap != philips_osd.previous_bitmap ||
+        memcmp(header, philips_osd.previous_region, sizeof(header))) {
+        fprintf(stderr, "[mt5891 osd] raw plane2 first region:"
+                " header=%08x bitmap=%08x %ux%u pitch=%u selectors=%02x"
+                " output=%ux%u pos=%u,%u next=%u\n", ptr, bitmap,
+                width, height, pitch, header[11],
+                lduw_le_p(header + 44) & 0x1fff,
+                lduw_le_p(header + 40) & 0xfff,
+                lduw_le_p(header + 46) & 0x1fff,
+                lduw_le_p(header + 42) & 0xfff, !!(header[14] & 0x80));
+        philips_osd.previous_header = ptr;
+        philips_osd.previous_bitmap = bitmap;
+        memcpy(philips_osd.previous_region, header, sizeof(header));
+    }
+    philips_osd.current_bitmap = bitmap;
+    rsel = (header[11] >> 4) & 3;
+    gsel = (header[11] >> 2) & 3;
+    bsel = header[11] & 3;
+    surface = qemu_console_surface(philips_osd.con);
+    if (surface_width(surface) != width || surface_height(surface) != height) {
+        qemu_console_resize(philips_osd.con, width, height);
+        surface = qemu_console_surface(philips_osd.con);
+    }
+    row = g_malloc(width * 4);
+    for (unsigned y = 0; y < height; ++y) {
+        uint32_t *dst = (uint32_t *)(surface_data(surface) +
+                                    y * surface_stride(surface));
+        /* View raw bitmap coordinates; mirror, flip and output positioning
+         * are panel-composition operations, not applied in this input view.
+         */
+        if (!philips_osd_dma_read(bitmap + y * pitch, row, width * 4)) {
+            g_free(row);
+            return true;
+        }
+        for (unsigned x = 0; x < width; ++x) {
+            const uint8_t *p = row + x * 4;
+            dst[x] = (p[rsel] << 16) | (p[gsel] << 8) | p[bsel];
+        }
+    }
+    g_free(row);
+    philips_osd.visible = true;
+    qemu_console_update(philips_osd.con, 0, 0, width, height);
+    return true;
+}
+
+static const GraphicHwOps philips_osd_ops = {
+    .gfx_update = philips_osd_update,
+};
+
+static void philips_osd_tick(void *opaque)
+{
+    uint8_t header[48];
+    uint32_t control = ldl_le_p(philips_osd.regs + 0x300);
+    uint32_t ptr = (ldl_le_p(philips_osd.regs + 0x304) & 0x0fffffff) << 4;
+
+    /* Keep the guest's current-bitmap query independent of a host viewer. */
+    if ((control & 1) && ptr &&
+        philips_osd_dma_read(ptr, header, sizeof(header))) {
+        philips_osd.current_bitmap =
+            (ldl_le_p(header + 4) & 0x0fffffff) << 4;
+    } else {
+        philips_osd.current_bitmap = 0;
+    }
+    /* Synthetic 60 Hz virtual-time cadence; no panel PLL/timing claim. */
+    philips_osd.pending |= 1U << 7;
+    philips_osd_irq_update();
+    timer_mod(philips_osd.timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+              16666667);
+}
+
+static bool philips_osd_read(hwaddr offset, unsigned size, uint64_t *value)
+{
+    uint32_t word;
+    unsigned shift = 8 * (offset & 3);
+    if (!philips_osd.enabled || !size || size > 4 ||
+        (offset & 3) + size > 4) {
+        return false;
+    }
+    if (offset >= 0x21000 && offset + size <= 0x21a00) {
+        if ((offset & ~3ULL) == 0x21324) {
+            word = philips_osd.current_bitmap >> 4;
+        } else {
+            word = ldl_le_p(philips_osd.regs + ((offset - 0x21000) & ~3ULL));
+        }
+    } else if ((offset & ~3ULL) == 0x808c) {
+        word = philips_osd.pending;
+    } else if ((offset & ~3ULL) == 0x8090) {
+        word = philips_osd.mask;
+    } else if ((offset & ~3ULL) == 0x807c) {
+        word = 0;
+    } else {
+        return false;
+    }
+    *value = (word >> shift) & (UINT32_MAX >> (8 * (4 - size)));
+    return true;
+}
+
+static bool philips_osd_write(hwaddr offset, unsigned size, uint64_t value)
+{
+    unsigned shift = 8 * (offset & 3);
+    uint32_t mask, word;
+    if (!philips_osd.enabled || !size || size > 4 ||
+        (offset & 3) + size > 4) {
+        return false;
+    }
+    mask = (UINT32_MAX >> (8 * (4 - size))) << shift;
+    word = value << shift;
+    if (offset >= 0x21000 && offset + size <= 0x21a00) {
+        uint8_t *p = philips_osd.regs + ((offset - 0x21000) & ~3ULL);
+        stl_le_p(p, (ldl_le_p(p) & ~mask) | (word & mask));
+    } else if ((offset & ~3ULL) == 0x8090) {
+        philips_osd.mask = (philips_osd.mask & ~mask) | (word & mask);
+        philips_osd_irq_update();
+    } else if ((offset & ~3ULL) == 0x807c) {
+        philips_osd.pending &= ~(word & mask);
+        philips_osd_irq_update();
+    } else if ((offset & ~3ULL) != 0x808c) {
+        return false;
+    }
+    return true;
+}
+
+static void philips_osd_init(qemu_irq irq)
+{
+    const char *enabled = getenv("PHILIPS_OSD_SCANOUT");
+    philips_osd.enabled = enabled && !strcmp(enabled, "1");
+    if (!philips_osd.enabled) {
+        return;
+    }
+    philips_osd.irq = irq;
+    philips_osd.con = qemu_graphic_console_create(NULL, 0, &philips_osd_ops,
+                                                NULL);
+    philips_osd.timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, philips_osd_tick, NULL);
+    timer_mod(philips_osd.timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 16666667);
+    fprintf(stderr, "[mt5891 osd] enabled raw plane2 first-region view;"
+            " virtual 60Hz SPI175, no panel/video composition\n");
+}

+/*
+ * MT5891 GFX reset, command queue, and bounded linear fill/copy subset.
+ * Unsupported operations stay pending and never generate completion.
+ * Offsets are relative to 0xf0000000.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "system/reset.h"
+#include "system/address-spaces.h"
+#include "system/memory.h"
+#include "hw/core/irq.h"
+#include "qemu/rcu.h"
+
+typedef struct PhilipsGfxBank {
+    uint32_t regs[0x1000 / 4];
+    unsigned reset_ready; /* Bit0 engine, bit1 command queue. */
+    bool pending;
+    uint32_t queue_pos;
+    uint64_t unsupported, completed, pixels;
+    uint64_t submission_bytes;
+} PhilipsGfxBank;
+
+static PhilipsGfxBank philips_gfx[2];
+static qemu_irq philips_gfx_irq;
+static uint32_t philips_gfx_irq_status, philips_gfx_irq_mask;
+
+static void philips_gfx_update_irq(void)
+{
+    if (philips_gfx_irq) {
+        qemu_set_irq(philips_gfx_irq,
+                     !!(philips_gfx_irq_status & philips_gfx_irq_mask));
+    }
+}
+
+static void philips_gfx_set_irq(qemu_irq irq)
+{
+    philips_gfx_irq = irq;
+    philips_gfx_update_irq();
+}
+
+static uint32_t philips_gfx_bim_status(void)
+{
+    return philips_gfx_irq_status;
+}
+
+static void philips_gfx_bim_enable(uint32_t value)
+{
+    philips_gfx_irq_mask = value & (1U << 25);
+    philips_gfx_update_irq();
+}
+
+static void philips_gfx_bim_clear(uint32_t value)
+{
+    philips_gfx_irq_status &= ~value;
+    philips_gfx_update_irq();
+}
+
+/* Never allow command DMA or rendering to touch MMIO, ROM, or RAM devices. */
+static bool philips_gfx_ram(hwaddr addr, size_t bytes, bool write)
+{
+    bool valid = true;
+    if (!bytes || addr > UINT32_MAX || bytes > 0x100000000ULL - addr) {
+        return false;
+    }
+    rcu_read_lock();
+    while (bytes) {
+        hwaddr translated, chunk = bytes;
+        MemoryRegion *mr = address_space_translate(&address_space_memory,
+                           addr, &translated, &chunk, write,
+                           MEMTXATTRS_UNSPECIFIED);
+        if (!chunk || !memory_region_is_ram(mr) ||
+            memory_region_is_ram_device(mr) ||
+            (write && memory_region_is_rom(mr))) {
+            valid = false;
+            break;
+        }
+        addr += chunk;
+        bytes -= chunk;
+    }
+    rcu_read_unlock();
+    return valid;
+}
+
+static bool philips_gfx_read_ram(hwaddr addr, void *data, size_t bytes)
+{
+    return philips_gfx_ram(addr, bytes, false) &&
+           address_space_read(&address_space_memory, addr,
+                              MEMTXATTRS_UNSPECIFIED, data, bytes) == MEMTX_OK;
+}
+
+static bool philips_gfx_write_ram(hwaddr addr, const void *data, size_t bytes)
+{
+    return philips_gfx_ram(addr, bytes, true) &&
+           address_space_write(&address_space_memory, addr,
+                               MEMTXATTRS_UNSPECIFIED, data, bytes) == MEMTX_OK;
+}
+
+static uint32_t philips_gfx_le32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | (uint32_t)p[1] << 8 |
+           (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+/*
+ * The shipped .rodata+0x244f4 table gives log2(bytes/pixel). Restrict to
+ * packed formats10..14. Format10 is also used by GFX_Memset as raw bytes.
+ * Same-format copies do not interpret color channels.
+ */
+static unsigned philips_gfx_pixel_size(unsigned format)
+{
+    static const uint8_t size[] = { 1, 2, 2, 2, 4 };
+    return format >= 10 && format <= 14 ? size[format - 10] : 0;
+}
+
+static bool philips_gfx_render(PhilipsGfxBank *bank, const char **reason)
+{
+    uint32_t *r = bank->regs;
+    unsigned op = (r[0x10 / 4] >> 4) & 31;
+    unsigned format = r[0x10 / 4] & 15;
+    unsigned bpp = philips_gfx_pixel_size(format);
+    unsigned width = r[0x28 / 4] & 0x7fff;
+    unsigned height = ((r[0x28 / 4] >> 16) & 0x7ff) |
+                      ((r[0x284 / 4] & 0x100) << 3);
+    unsigned dst_pitch = (r[0x2c / 4] & 0xffff) * 16;
+    unsigned src_pitch = (r[0x2c / 4] >> 16) * 16;
+    uint64_t dst = (r[0x1c / 4] & 0x3fffffffU) |
+                   (uint64_t)((r[0x118 / 4] >> 16) & 3) << 30;
+    uint64_t src = (r[0x18 / 4] & 0x3fffffffU) |
+                   (uint64_t)((r[0x118 / 4] >> 12) & 3) << 30;
+    size_t row, dst_span, src_span = 0;
+    uint8_t *buffer;
+    unsigned y, x, reg;
+    height++;
+    *reason = "unsupported opcode/format or transform";
+    if ((op != 2 && op != 6) || !bpp ||
+        (r[0x10 / 4] & ~0x000019ffU) ||
+        (r[0x44 / 4] & ~0xc0000000U)) {
+        return false;
+    }
+    if (op == 6 && ((r[0x28 / 4] >> 27) & 15) != format) {
+        *reason = "format conversion";
+        return false;
+    }
+    /* Only direct physical addresses; MMU enable is alias0x180 bit0. */
+    if (r[0x180 / 4] & 1) {
+        *reason = "GFX MMU translation";
+        return false;
+    }
+    if (r[0x118 / 4] & ~0x00033000U) {
+        *reason = "extended surface flags";
+        return false;
+    }
+    /*
+     * Refuse state that could enable unimplemented blending, color maps,
+     * clipping, compression, or channel-order conversion. These are the
+     * decoded registers and exact reset defaults needed by this subset.
+     */
+    for (reg = 0x10; reg <= 0x12c; reg += 4) {
+        uint32_t value = r[reg / 4];
+        if (!value) {
+            continue;
+        }
+        switch (reg) {
+        case 0x10: case 0x14: case 0x18: case 0x1c:
+        case 0x28: case 0x2c: case 0x44: case 0x118:
+            continue;
+        case 0x4c:
+            if (value == UINT32_MAX) { continue; }
+            break;
+        case 0x104:
+            if (value == 0x00400000) { continue; }
+            break;
+        case 0x11c:
+            if (!(value & ~0x303U)) { continue; }
+            break;
+        case 0x12c:
+            if (value == 0x98000000) { continue; }
+            break;
+        }
+        *reason = "unimplemented nonzero drawing configuration";
+        return false;
+    }
+    if ((r[0x284 / 4] & ~0x100U) ||
+        r[0x280 / 4] || r[0x288 / 4]) {
+        *reason = "extended drawing mode";
+        return false;
+    }
+    row = (size_t)width * bpp;
+    *reason = "invalid dimensions or stride";
+    if (!width || height > 4096 ||
+        dst_pitch < row || (op == 6 && src_pitch < row)) {
+        return false;
+    }
+    dst_span = (size_t)(height - 1) * dst_pitch + row;
+    if (op == 6) {
+        src_span = (size_t)(height - 1) * src_pitch + row;
+    }
+    if (dst_span > 64 * 1024 * 1024 || src_span > 64 * 1024 * 1024) {
+        *reason = "surface exceeds 64MiB operation bound";
+        return false;
+    }
+    if (bank->submission_bytes + row * height > 256 * 1024 * 1024) {
+        *reason = "submission exceeds 256MiB rendering budget";
+        return false;
+    }
+    *reason = "unmapped/readonly surface or MMIO";
+    if (!philips_gfx_ram(dst, dst_span, true) ||
+        (op == 6 && !philips_gfx_ram(src, src_span, false))) {
+        return false;
+    }
+    /* Direction/overlap semantics need a separate decoded implementation. */
+    if (op == 6 && src < dst + dst_span && dst < src + src_span) {
+        *reason = "overlapping copy";
+        return false;
+    }
+    buffer = g_malloc(row);
+    if (op == 2) {
+        uint32_t color = r[0x14 / 4];
+        for (x = 0; x < row; x++) {
+            buffer[x] = color >> (8 * (x % bpp));
+        }
+    }
+    for (y = 0; y < height; y++) {
+        if ((op == 6 && !philips_gfx_read_ram(src + (uint64_t)y * src_pitch,
+                                             buffer, row)) ||
+            !philips_gfx_write_ram(dst + (uint64_t)y * dst_pitch,
+                                   buffer, row)) {
+            g_free(buffer);
+            *reason = "surface transfer failed";
+            return false;
+        }
+    }
+    g_free(buffer);
+    bank->pixels += (uint64_t)width * height;
+    bank->submission_bytes += row * height;
+    r[0x10 / 4] &= ~(1U << 11);
+    return true;
+}
+
+static bool philips_gfx_queue(PhilipsGfxBank *bank, uint32_t bytes,
+                              const char **reason)
+{
+    uint32_t *r = bank->regs;
+    unsigned shift = (r[0x08 / 4] >> 30) +
+                     ((r[0] & (1U << 16)) ? 0 : 4);
+    uint32_t capacity = 2048U << shift;
+    hwaddr base = (r[0x08 / 4] & 0x3fffffffU) |
+                  (uint64_t)((r[0x11c / 4] >> 8) & 3) << 30;
+    uint32_t remaining;
+    *reason = "invalid command queue bounds/mode";
+    if (!(r[0] & 1) || (bytes & 7) || !bytes ||
+        bytes > capacity || (base & 7) || bank->queue_pos >= capacity ||
+        !philips_gfx_ram(base, capacity, false)) {
+        return false;
+    }
+    for (remaining = bytes; remaining; remaining -= 8) {
+        uint8_t command[8];
+        uint32_t value, address, reg;
+        if (!philips_gfx_read_ram(base + bank->queue_pos, command, 8)) {
+            *reason = "command queue transfer failed";
+            return false;
+        }
+        value = philips_gfx_le32(command);
+        address = philips_gfx_le32(command + 4);
+        /* Accept only decoded GFX configuration/launch targets. */
+        if ((address & 0xfffff000U) != 0xf0004000U || (address & 3)) {
+            *reason = "unsupported command target";
+            return false;
+        }
+        reg = address & 0xfff;
+        if (reg == 0 &&
+            (value == 0xaec0031f || value == 0xaac0031f)) {
+            /* Exact GFX_ClearRegister pipeline-control pulse. */
+            r[0] = value;
+            bank->queue_pos = (bank->queue_pos + 8) % capacity;
+            continue;
+        }
+        if (reg == 0x180 || reg == 0x188 ||
+            reg == 0x18c || reg == 0x190) {
+            /*
+             * Exact disabled-MMU sequence emitted by _GFX_MMU_Set_Cfg:
+             * agents disabled (bit0), global enable0, self-fire bit31.
+             * An empty/disabled translation cache has no entries to flush.
+             */
+            bool valid = (reg == 0x180 && value == 0xfe) ||
+                         (reg == 0x188 &&
+                          (value == 0x30 || value == 0x300030)) ||
+                         (reg == 0x18c && value == 0x30) ||
+                         (reg == 0x190 && value == 0x80000000 &&
+                          !(r[0x180 / 4] & 1));
+            if (!valid) {
+                *reason = "unsupported MMU operation";
+                return false;
+            }
+            r[reg / 4] = reg == 0x190 ? 0 : value;
+            bank->queue_pos = (bank->queue_pos + 8) % capacity;
+            continue;
+        }
+        if (!((reg >= 0x10 && reg <= 0x12c) ||
+              (reg >= 0x280 && reg <= 0x288))) {
+            *reason = "unsupported configuration/MMU register";
+            return false;
+        }
+        r[reg / 4] = value;
+        if (reg == 0x10 && (value & (1U << 11)) &&
+            !philips_gfx_render(bank, reason)) {
+            return false;
+        }
+        bank->queue_pos = (bank->queue_pos + 8) % capacity;
+    }
+    /* The driver exposes the read pointer masked3fff0000 then shifted12. */
+    r[0x168 / 4] = (bank->queue_pos << 12) & 0x3fff0000U;
+    return true;
+}
+
+static PhilipsGfxBank *philips_gfx_bank(hwaddr off, unsigned *reg)
+{
+    if (off >= 0x4000 && off < 0x5000) {
+        *reg = off - 0x4000;
+        return &philips_gfx[0];
+    }
+    if (off >= 0x5c000 && off < 0x5d000) {
+        *reg = off - 0x5c000;
+        return &philips_gfx[1];
+    }
+    return NULL;
+}
+
+static bool philips_gfx_access_valid(hwaddr off, unsigned size)
+{
+    return (size == 1 || size == 2 || size == 4) &&
+           (off & 3) + size <= 4;
+}
+
+static void philips_gfx_submit(PhilipsGfxBank *bank, unsigned reg,
+                               uint32_t value)
+{
+    const char *reason = "prior unsupported work still pending";
+    bool success = false;
+    if (!bank->pending && bank->reset_ready == 3) {
+        bank->submission_bytes = 0;
+        success = reg == 0x0c ? philips_gfx_queue(bank, value, &reason) :
+                               philips_gfx_render(bank, &reason);
+    }
+    if (success) {
+        bank->completed++;
+        bank->regs[0x0c / 4] = 0;
+        philips_gfx_irq_status |= 1U << 25;
+        philips_gfx_update_irq();
+        if (bank->completed <= 16) {
+            fprintf(stderr, "[mt5891-gfx] completed bank=%u %s "
+                    "bytes=%u pixels=%" PRIu64 "\n",
+                    (unsigned)(bank - philips_gfx),
+                    reg == 0x0c ? "queue" : "draw", value, bank->pixels);
+        }
+        return;
+    }
+    bank->pending = true;
+    bank->unsupported++;
+    if (bank->unsupported <= 32 ||
+        !(bank->unsupported & (bank->unsupported - 1))) {
+        fprintf(stderr,
+                "[mt5891-gfx] unsupported %s bank=%u value=%08x "
+                "opcode=%u queue=%08x reason=%s; pending, no completion "
+                "(count=%" PRIu64 ")\n",
+                reg == 0x0c ? "command queue" : "render command",
+                (unsigned)(bank - philips_gfx), value,
+                (bank->regs[0x10 / 4] >> 4) & 31,
+                bank->regs[0x08 / 4], reason, bank->unsupported);
+    }
+}
+
+static uint32_t philips_gfx_control(PhilipsGfxBank *bank, uint32_t next,
+                                   uint32_t write_mask)
+{
+    uint32_t previous = bank->regs[0];
+    unsigned pair;
+
+    /*
+     * GFX_HwResetEngine and GFX_HwResetCmdQue assert their field to 3,
+     * release it to 0, then poll for 2. GFX_HwReset does both together.
+     * Its secondary bank uses 3 -> 2 directly. Untouched byte lanes must
+     * not reassert reset just because an earlier field reads as 3.
+     */
+    for (pair = 0; pair < 2; pair++) {
+        unsigned shift = pair ? 28 : 30;
+        unsigned old_field = (previous >> shift) & 3;
+        unsigned new_field = (next >> shift) & 3;
+        uint32_t field_mask = 3U << shift;
+        if (!(write_mask & field_mask)) {
+            continue;
+        }
+        if (new_field == 3) {
+            bank->reset_ready &= ~(1U << pair);
+            bank->pending = false;
+            if (pair) {
+                bank->queue_pos = 0;
+            }
+        } else if (old_field == 3 &&
+                   (new_field == 0 || new_field == 2)) {
+            next = (next & ~field_mask) | (2U << shift);
+            bank->reset_ready |= 1U << pair;
+            fprintf(stderr,
+                    "[mt5891-gfx] bank=%u %s reset complete\n",
+                    (unsigned)(bank - philips_gfx),
+                    pair ? "queue" : "engine");
+        } else if (new_field != 2) {
+            bank->reset_ready &= ~(1U << pair);
+        }
+    }
+    return next;
+}
+
+static bool philips_gfx_read(hwaddr off, unsigned size, uint64_t *value)
+{
+    PhilipsGfxBank *bank;
+    unsigned reg;
+    uint32_t word;
+    if (!philips_gfx_access_valid(off, size)) {
+        return false;
+    }
+    bank = philips_gfx_bank(off, &reg);
+    if (!bank) {
+        return false;
+    }
+    if ((reg & ~3U) == 4) {
+        /*
+         * The driver's idle tests require bit0 and low-six-bit value0x21.
+         * Hardware revision bits15:8 are unknown and deliberately remain0.
+         */
+        word = bank->reset_ready == 3 && !bank->pending ? 0x21 : 0;
+    } else {
+        word = bank->regs[reg / 4];
+    }
+    *value = (word >> (8 * (reg & 3))) &
+             ((1ULL << (8 * size)) - 1);
+    return true;
+}
+
+static bool philips_gfx_write(hwaddr off, unsigned size, uint64_t value)
+{
+    PhilipsGfxBank *bank;
+    unsigned reg, shift;
+    uint32_t mask, next, written;
+    if (!philips_gfx_access_valid(off, size)) {
+        return false;
+    }
+    bank = philips_gfx_bank(off, &reg);
+    if (!bank) {
+        return false;
+    }
+    shift = 8 * (reg & 3);
+    reg &= ~3U;
+    if (reg == 4) {
+        return true; /* Device owns idle and hardware revision status. */
+    }
+    mask = ((1ULL << (8 * size)) - 1) << shift;
+    written = (value << shift) & mask;
+    next = (bank->regs[reg / 4] & ~mask) | written;
+    if (reg == 0) {
+        next = philips_gfx_control(bank, next, mask);
+    }
+    bank->regs[reg / 4] = next;
+    if (reg == 0x08) {
+        bank->queue_pos = 0;
+    }
+    if ((reg == 0x0c && written != 0) ||
+        (reg == 0x10 && (written & (1U << 11)))) {
+        philips_gfx_submit(bank, reg, next);
+    }
+    return true;
+}
+
+static void philips_gfx_reset(void *opaque)
+{
+    (void)opaque;
+    memset(philips_gfx, 0, sizeof(philips_gfx));
+    philips_gfx_irq_status = 0;
+    philips_gfx_irq_mask = 1U << 25;
+    philips_gfx_update_irq();
+}
+
+static void philips_gfx_init(void)
+{
+    philips_gfx_reset(NULL);
+    qemu_register_reset(philips_gfx_reset, NULL);
+}

+++ b/hw/sd/mt5891-msdc.c
@@ -0,0 +1,465 @@
+/*
+ * MediaTek MT5891 MSDC controller, functional bring-up model with opt-in writes.
+ * Register/descriptor layout: vendor Linux 3.10 mtk_msdc_host_hw.h.
+ * Card protocol is delegated to QEMU's eMMC model, including card state,
+ * CID/CSD/EXT_CSD, addressing and block backend bounds checks.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/bswap.h"
+#include "qemu/units.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "hw/core/sysbus.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/sd/sd.h"
+#include "system/dma.h"
+#include "migration/vmstate.h"
+#include "qom/object.h"
+
+#define TYPE_MT5891_MSDC "mt5891-msdc"
+OBJECT_DECLARE_SIMPLE_TYPE(MT5891MSDCState, MT5891_MSDC)
+#define REG(s, off) ((s)->regs[(off) / 4])
+#define I_ACMD   (1U << 3)
+#define I_QEMPTY (1U << 6)
+#define I_CMD    (1U << 8)
+#define I_CMDTO  (1U << 9)
+#define I_XFER   (1U << 12)
+#define I_DMA    (1U << 13)
+#define I_DATTO  (1U << 14)
+#define MAX_DESCRIPTORS 4096
+
+struct MT5891MSDCState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    SDBus sdbus;
+    qemu_irq irq;
+    uint32_t regs[0x1000 / 4];
+    uint32_t remaining;
+    bool trace;
+    bool allow_writes;
+    bool transfer_write;
+};
+
+static void msdc_irq(MT5891MSDCState *s)
+{
+    qemu_set_irq(s->irq, !!(REG(s, 0x0c) & REG(s, 0x10)));
+}
+
+static void msdc_data_end(MT5891MSDCState *s)
+{
+    uint32_t auto_cmd = (REG(s, 0x34) >> 28) & 3;
+    REG(s, 0x0c) |= I_XFER;
+    if (auto_cmd == 1) {
+        SDRequest req = { .cmd = 12, .arg = 0 };
+        uint8_t resp[16];
+        size_t n = sdbus_do_command(&s->sdbus, &req, resp, sizeof(resp));
+        if (n == 4) {
+            REG(s, 0x80) = ldl_be_p(resp);
+            REG(s, 0x0c) |= I_ACMD;
+        } else {
+            REG(s, 0x0c) |= 1U << 4; /* Auto-command timeout */
+        }
+    }
+    msdc_irq(s);
+}
+
+static unsigned msdc_card_chunk(MT5891MSDCState *s, unsigned n)
+{
+    unsigned opcode = REG(s, 0x34) & 63;
+    unsigned block_size = (REG(s, 0x34) >> 16) & 0xfff;
+
+    /*
+     * These eMMC commands transfer 512-byte blocks. Keep each bulk request
+     * inside a card block, including when a BD ends in the middle of one.
+     * Other command/block-size combinations retain byte-granular readiness
+     * checks until their card data phase has been modelled explicitly.
+     */
+    if (block_size == 512 &&
+        (opcode == 8 || opcode == 17 || opcode == 18 ||
+         opcode == 24 || opcode == 25)) {
+        unsigned left = s->remaining % 512;
+        return MIN(n, left ? left : 512);
+    }
+    return MIN(n, 1);
+}
+
+static bool msdc_pull(MT5891MSDCState *s, uint8_t *buf, unsigned n)
+{
+    if (s->transfer_write || n > s->remaining) {
+        return false;
+    }
+    while (n) {
+        unsigned chunk = msdc_card_chunk(s, n);
+        if (!sdbus_data_ready(&s->sdbus)) {
+            REG(s, 0x0c) |= I_DATTO;
+            s->remaining = 0;
+            msdc_irq(s);
+            return false;
+        }
+        sdbus_read_data(&s->sdbus, buf, chunk);
+        buf += chunk;
+        n -= chunk;
+        s->remaining -= chunk;
+    }
+    return true;
+}
+
+static bool msdc_push(MT5891MSDCState *s, const uint8_t *buf, unsigned n)
+{
+    if (!s->allow_writes || !s->transfer_write || n > s->remaining) {
+        return false;
+    }
+    while (n) {
+        unsigned chunk = msdc_card_chunk(s, n);
+        if (!sdbus_receive_ready(&s->sdbus)) {
+            REG(s, 0x0c) |= I_DATTO;
+            s->remaining = 0;
+            msdc_irq(s);
+            return false;
+        }
+        sdbus_write_data(&s->sdbus, buf, chunk);
+        buf += chunk;
+        n -= chunk;
+        s->remaining -= chunk;
+    }
+    return true;
+}
+
+static bool msdc_dma_buffer(MT5891MSDCState *s, uint32_t addr, uint32_t length)
+{
+    uint8_t buf[512];
+    if (!length || length > s->remaining) {
+        return false;
+    }
+    while (length) {
+        unsigned n = MIN(length, sizeof(buf));
+        if (s->transfer_write) {
+            if (dma_memory_read(&address_space_memory, addr, buf, n,
+                                MEMTXATTRS_UNSPECIFIED) != MEMTX_OK ||
+                !msdc_push(s, buf, n)) {
+                return false;
+            }
+        } else if (!msdc_pull(s, buf, n) ||
+                   dma_memory_write(&address_space_memory, addr, buf, n,
+                                    MEMTXATTRS_UNSPECIFIED) != MEMTX_OK) {
+            return false;
+        }
+        addr += n;
+        length -= n;
+    }
+    REG(s, 0x94) = addr;
+    return true;
+}
+
+static bool msdc_descriptor(MT5891MSDCState *s, uint32_t addr,
+                            uint8_t *desc, bool gpd)
+{
+    unsigned sum = 0, i;
+    if (dma_memory_read(&address_space_memory, addr, desc, 16,
+                        MEMTXATTRS_UNSPECIFIED) != MEMTX_OK) {
+        return false;
+    }
+    if (REG(s, 0x9c) & 2) {
+        for (i = 0; i < 16; i++) {
+            sum += desc[i];
+        }
+        if ((sum & 0xff) != 0xff) {
+            REG(s, 0x9c) |= gpd ? 0x20 : 0x10;
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool msdc_dma_descriptors(MT5891MSDCState *s)
+{
+    uint32_t gp = REG(s, 0x90);
+    unsigned budget = MAX_DESCRIPTORS;
+    while (s->remaining && budget--) {
+        uint8_t gpd[16], bd[16];
+        uint32_t flags, ptr;
+        if (!msdc_descriptor(s, gp, gpd, true)) {
+            return false;
+        }
+        flags = ldl_le_p(gpd);
+        if (!(flags & 1)) { /* No descriptor owned by hardware. */
+            return false;
+        }
+        ptr = ldl_le_p(gpd + 8);
+        if (flags & 2) {
+            bool end = false;
+            while (!end && budget && s->remaining) {
+                budget--;
+                if (!msdc_descriptor(s, ptr, bd, false) ||
+                    !msdc_dma_buffer(s, ldl_le_p(bd + 8),
+                                     ldl_le_p(bd + 12) & 0xffff)) {
+                    return false;
+                }
+                end = ldl_le_p(bd) & 1;
+                ptr = ldl_le_p(bd + 4);
+            }
+            if (!end) {
+                return false;
+            }
+        } else if (!msdc_dma_buffer(s, ptr, ldl_le_p(gpd + 12) & 0xffff)) {
+            return false;
+        }
+        /* Return descriptor ownership to the driver. */
+        stl_le_p(gpd, flags & ~1U);
+        if (dma_memory_write(&address_space_memory, gp, gpd, 4,
+                             MEMTXATTRS_UNSPECIFIED) != MEMTX_OK) {
+            return false;
+        }
+        gp = ldl_le_p(gpd + 4);
+    }
+    return s->remaining == 0;
+}
+
+static void msdc_dma(MT5891MSDCState *s)
+{
+    bool descriptor = REG(s, 0x98) & 0x100;
+    bool ok;
+    REG(s, 0x9c) |= 1;
+    if (!s->remaining) {
+        ok = false;
+    } else if (descriptor) {
+        ok = msdc_dma_descriptors(s);
+    } else {
+        uint32_t len = REG(s, 0xa8);
+        if (!len) {
+            len = REG(s, 0x98) >> 16;
+        }
+        ok = !((REG(s, 0x98) & 0x400) && len != s->remaining) &&
+             msdc_dma_buffer(s, REG(s, 0x90), len);
+    }
+    REG(s, 0x9c) &= ~1U;
+    REG(s, 0x98) &= ~5U;
+    if (ok) {
+        REG(s, 0x0c) |= I_DMA;
+        if (descriptor) {
+            REG(s, 0x0c) |= I_QEMPTY;
+        }
+        if (!s->remaining) {
+            msdc_data_end(s);
+        }
+    } else {
+        REG(s, 0x0c) |= I_DATTO;
+        qemu_log_mask(LOG_GUEST_ERROR, "mt5891-msdc: DMA failed at %08x remaining=%u\n",
+                      REG(s, 0x90), s->remaining);
+    }
+    msdc_irq(s);
+}
+
+static void msdc_command(MT5891MSDCState *s)
+{
+    uint32_t cmd = REG(s, 0x34);
+    unsigned opcode = cmd & 63, response_type = (cmd >> 7) & 7;
+    uint8_t response[16] = {0};
+    SDRequest req = { .cmd = opcode, .arg = REG(s, 0x38) };
+    size_t n;
+    s->remaining = 0;
+    if (s->trace) {
+        fprintf(stderr, "[mt5891-msdc] CMD%u arg=%08x ctrl=%08x blocks=%u\n",
+                opcode, req.arg, cmd, REG(s, 0x50));
+    }
+    s->transfer_write = !!(cmd & (1U << 13));
+    /* Reject a direction mismatch before the card can enter a transfer. */
+    if (((opcode == 24 || opcode == 25) && !s->transfer_write) ||
+        ((opcode == 8 || opcode == 17 || opcode == 18) && s->transfer_write)) {
+        REG(s, 0x40) = (1U << 22) | (4U << 9) | (1U << 8);
+        REG(s, 0x0c) |= I_CMD | I_DATTO;
+        msdc_irq(s);
+        return;
+    }
+    /* Only CMD24/25 data writes are opt-in. Erase/program/lock stay rejected. */
+    if ((s->transfer_write && (!s->allow_writes ||
+                              (opcode != 24 && opcode != 25))) ||
+        opcode == 26 || opcode == 27 || opcode == 28 || opcode == 29 ||
+        opcode == 35 || opcode == 36 || opcode == 38 || opcode == 42) {
+        REG(s, 0x40) = (1U << 26) | (4U << 9) | (1U << 8); /* WP_VIOLATION */
+        REG(s, 0x0c) |= I_CMD | I_DATTO;
+        msdc_irq(s);
+        return;
+    }
+    if (((cmd >> 28) & 3) == 2 && ((cmd >> 11) & 3)) {
+        SDRequest pre = { .cmd = 23, .arg = REG(s, 0x50) };
+        n = sdbus_do_command(&s->sdbus, &pre, response, sizeof(response));
+        if (n != 4) {
+            REG(s, 0x0c) |= 1U << 4;
+            msdc_irq(s);
+            return;
+        }
+        REG(s, 0x80) = ldl_be_p(response);
+        REG(s, 0x0c) |= I_ACMD;
+    }
+    n = sdbus_do_command(&s->sdbus, &req, response, sizeof(response));
+    if (response_type && n != (response_type == 2 ? 16 : 4)) {
+        REG(s, 0x0c) |= I_CMDTO;
+    } else {
+        unsigned i;
+        for (i = 0; i < 4; i++) {
+            REG(s, 0x40 + 4 * i) = 0;
+        }
+        if (n == 16) {
+            for (i = 0; i < 4; i++) {
+                REG(s, 0x40 + 4 * (3 - i)) = ldl_be_p(response + 4 * i);
+            }
+        } else if (n == 4) {
+            REG(s, 0x40) = ldl_be_p(response);
+        }
+        REG(s, 0x0c) |= I_CMD;
+        if ((cmd >> 11) & 3) {
+            uint32_t size = (cmd >> 16) & 0xfff;
+            uint32_t blocks = MAX(REG(s, 0x50), 1U);
+            uint64_t total = (uint64_t)size * blocks;
+            if (!size || total > 64 * MiB ||
+                (s->transfer_write ? !sdbus_receive_ready(&s->sdbus) :
+                                     !sdbus_data_ready(&s->sdbus))) {
+                REG(s, 0x0c) |= I_DATTO;
+            } else {
+                s->remaining = total;
+            }
+        }
+    }
+    msdc_irq(s);
+}
+
+static uint64_t msdc_read(void *opaque, hwaddr off, unsigned size)
+{
+    MT5891MSDCState *s = opaque;
+    switch (off) {
+    case 0x08: /* Command/data pins high; card detect asserted. */
+        return 0x1ff0000;
+    case 0x14:
+        return s->transfer_write ? 0 : MIN(s->remaining, 128U);
+    case 0x1c: {
+        uint8_t data[4] = {0};
+        unsigned n = MIN(s->remaining, size);
+        if (n) {
+            if (!msdc_pull(s, data, n)) {
+                REG(s, 0x0c) |= I_DATTO;
+                msdc_irq(s);
+            } else if (!s->remaining) {
+                msdc_data_end(s);
+            }
+        }
+        return ldl_le_p(data);
+    }
+    case 0x3c:
+        return 0; /* Synchronous command engine has no outstanding command. */
+    default:
+        return REG(s, off);
+    }
+}
+
+static void msdc_write(void *opaque, hwaddr off, uint64_t value, unsigned size)
+{
+    MT5891MSDCState *s = opaque;
+    switch (off) {
+    case 0x00:
+        REG(s, off) = (value & ~4U) | 0x80; /* Self-clearing reset, clock stable */
+        if (value & 4) {
+            s->remaining = 0;
+            REG(s, 0x0c) = 0;
+            REG(s, 0x9c) &= ~1U;
+        }
+        break;
+    case 0x0c: /* W1C */
+        REG(s, off) &= ~value;
+        break;
+    case 0x14:
+        /* FIFO clear does not abort the card's command. No staged FIFO here. */
+        break;
+    case 0x18: {
+        uint8_t bytes[4];
+        stl_le_p(bytes, value);
+        if (!s->remaining || !msdc_push(s, bytes, size)) {
+            REG(s, 0x0c) |= I_DATTO;
+        } else if (!s->remaining) {
+            msdc_data_end(s);
+        }
+        break;
+    }
+    case 0x34:
+        REG(s, off) = value;
+        msdc_command(s);
+        break;
+    case 0x98:
+        REG(s, off) = value;
+        if (value & 2) {
+            REG(s, off) &= ~7U;
+            REG(s, 0x9c) &= ~1U;
+        } else if (value & 5) {
+            msdc_dma(s);
+        }
+        break;
+    default:
+        REG(s, off) = value;
+        break;
+    }
+    msdc_irq(s);
+}
+
+static const MemoryRegionOps msdc_ops = {
+    .read = msdc_read,
+    .write = msdc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static void msdc_reset(DeviceState *dev)
+{
+    MT5891MSDCState *s = MT5891_MSDC(dev);
+    memset(s->regs, 0, sizeof(s->regs));
+    REG(s, 0x00) = 0x81;
+    REG(s, 0xfc) = 0x00010000;
+    REG(s, 0x104) = 4;
+    s->remaining = 0;
+    msdc_irq(s);
+}
+
+static void msdc_init(Object *obj)
+{
+    MT5891MSDCState *s = MT5891_MSDC(obj);
+    memory_region_init_io(&s->iomem, obj, &msdc_ops, s, TYPE_MT5891_MSDC, 0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq);
+    qbus_init(&s->sdbus, sizeof(s->sdbus), TYPE_SD_BUS, DEVICE(obj), "emmc-bus");
+}
+
+static const Property msdc_properties[] = {
+    DEFINE_PROP_BOOL("trace", MT5891MSDCState, trace, false),
+    DEFINE_PROP_BOOL("allow-writes", MT5891MSDCState, allow_writes, false),
+};
+
+static const VMStateDescription msdc_vmstate = {
+    .name = TYPE_MT5891_MSDC,
+    .unmigratable = true,
+};
+
+static void msdc_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    device_class_set_legacy_reset(dc, msdc_reset);
+    device_class_set_props(dc, msdc_properties);
+    dc->desc = "MediaTek MT5891 MSDC functional controller";
+    dc->user_creatable = false;
+    /* Migrating in-flight controller/card transfers is not implemented. */
+    dc->vmsd = &msdc_vmstate;
+}
+
+static const TypeInfo msdc_info = {
+    .name = TYPE_MT5891_MSDC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(MT5891MSDCState),
+    .instance_init = msdc_init,
+    .class_init = msdc_class_init,
+};
+
+static void msdc_register_types(void)
+{
+    type_register_static(&msdc_info);
+}
+type_init(msdc_register_types)
